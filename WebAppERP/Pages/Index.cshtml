@page
@model IndexModel
@{
    ViewData["Title"] = "Principal";
}
@functions {
    // Momento da atividade de forma curta: "agora", "ha 5 min", "hoje 14:20"...
    static string QuandoFoi(DateTime d)
    {
        var dif = DateTime.Now - d;
        if (dif.TotalMinutes < 1) return "agora";
        if (dif.TotalMinutes < 60) return $"há {(int)dif.TotalMinutes} min";
        if (d.Date == DateTime.Today) return $"hoje {d:HH:mm}";
        if (d.Date == DateTime.Today.AddDays(-1)) return $"ontem {d:HH:mm}";
        return d.ToString("dd/MM/yyyy HH:mm");
    }
}

<!-- Menu de acesso rapido e atividades no sistema -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <ul class="nav nav-tabs painel-abas" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#painelMenu">
                            <i class="bi bi-grid-3x3-gap me-1"></i>Menu
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#painelLinks">
                            <i class="bi bi-link-45deg me-1"></i>Links Úteis
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content">
                <div class="tab-pane fade show active" id="painelMenu" role="tabpanel">
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="buscaAcesso" placeholder="Buscar funcionalidade..." autocomplete="off" />
                    </div>
                    @* Itens montados pelo script a partir do menu lateral *@
                    <div class="acesso-lista" id="listaAcesso"></div>
                    <div class="text-muted text-center py-4 d-none" id="acessoVazio">Nenhuma funcionalidade encontrada</div>
                </div>
                <div class="tab-pane fade" id="painelLinks" role="tabpanel">
                    <div class="acesso-lista">
                        <a class="acesso-item" href="https://solucoes.receita.fazenda.gov.br/servicos/cnpjreva/cnpj_solicitacao.asp" target="_blank" rel="noopener">
                            <span><i class="bi bi-building me-2"></i>Consulta CNPJ (Receita Federal)</span><i class="bi bi-box-arrow-up-right"></i>
                        </a>
                        <a class="acesso-item" href="https://servicos.receita.fazenda.gov.br/servicos/cpf/consultasituacao/consultapublica.asp" target="_blank" rel="noopener">
                            <span><i class="bi bi-person-vcard me-2"></i>Consulta CPF (Receita Federal)</span><i class="bi bi-box-arrow-up-right"></i>
                        </a>
                        <a class="acesso-item" href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" rel="noopener">
                            <span><i class="bi bi-mailbox me-2"></i>Busca CEP (Correios)</span><i class="bi bi-box-arrow-up-right"></i>
                        </a>
                        <a class="acesso-item" href="https://www.nfe.fazenda.gov.br/portal/principal.aspx" target="_blank" rel="noopener">
                            <span><i class="bi bi-receipt me-2"></i>Portal da NF-e</span><i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h6 class="fw-bold mb-0 py-1"><i class="bi bi-activity me-2"></i>Atividades no sistema</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.Atividades.Any())
                {
                    <div class="atividades-lista">
                        @foreach (var a in Model.Atividades)
                        {
                            <a class="atividade-item" href="@Url.Page(a.Pagina, a.Rota)"
                               data-abrir-aba data-aba-titulo="@a.TituloAba" data-aba-icone="bi @a.Icone">
                                <span class="atividade-icone" style="color: @a.Cor; background: @(a.Cor)1a;">
                                    <i class="bi @a.Icone"></i>
                                </span>
                                <span class="flex-grow-1 overflow-hidden">
                                    <span class="d-block fw-semibold">@a.Titulo</span>
                                    <span class="d-block text-muted small text-truncate">@a.Detalhe</span>
                                </span>
                                <span class="text-muted small text-nowrap" title="@a.Data.ToString("dd/MM/yyyy HH:mm")">@QuandoFoi(a.Data)</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted text-center py-5">Nenhuma atividade registrada no sistema.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card kpi-card kpi-blue">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="kpi-label">Agendamentos Hoje</div>
                    <div class="kpi-value mt-1">@Model.TotalAgendamentosHoje</div>
                </div>
                <div class="kpi-icon" style="background: #dbeafe; color: #3b82f6;">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card kpi-card kpi-green">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="kpi-label">Faturamento do Mês</div>
                    <div class="kpi-value mt-1">R$ @Model.FaturamentoMes.ToString("N2")</div>
                </div>
                <div class="kpi-icon" style="background: #dcfce7; color: #10b981;">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card kpi-card kpi-orange">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="kpi-label">Clientes Ativos</div>
                    <div class="kpi-value mt-1">@Model.TotalClientesAtivos</div>
                </div>
                <div class="kpi-icon" style="background: #fef3c7; color: #f59e0b;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card kpi-card kpi-purple">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="kpi-label">Serviços Realizados</div>
                    <div class="kpi-value mt-1">@Model.TotalServicosMes</div>
                </div>
                <div class="kpi-icon" style="background: #ede9fe; color: #8b5cf6;">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Faturamento Semanal</h6>
                <div class="chart-wrapper">
                    <canvas id="chartFaturamento"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Serviços Mais Solicitados</h6>
                <div class="chart-wrapper">
                    <canvas id="chartServicos"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row -->
<div class="row g-3">
    <div class="col-lg-7">
        <div class="table-container">
            <div class="table-header">
                <h5><i class="bi bi-calendar-event me-2"></i>Próximos Agendamentos</h5>
                <a asp-page="/Cadastro/Agendamentos" class="btn btn-sm btn-outline-primary" data-abrir-aba>Ver Todos</a>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Horario</th>
                            <th>Cliente</th>
                            <th>Serviço</th>
                            <th>Profissional</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProximosAgendamentos.Any())
                        {
                            @foreach (var a in Model.ProximosAgendamentos)
                            {
                                var badgeClass = a.TpStatus switch
                                {
                                    "AGENDADO" => "badge-agendado",
                                    "CONFIRMADO" => "badge-confirmado",
                                    "EM_ATENDIMENTO" => "badge-em-atendimento",
                                    "CONCLUIDO" => "badge-concluido",
                                    _ => "badge-agendado"
                                };
                                <tr>
                                    <td><strong>@a.HrInicio.ToString("HH:mm")</strong></td>
                                    <td>@a.Cliente?.NmCliente</td>
                                    <td>@a.Servico?.DsServico</td>
                                    <td>@a.Funcionario?.NmFuncionario</td>
                                    <td><span class="badge-status @badgeClass">@a.TpStatus.Replace("_", " ")</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Nenhum agendamento encontrado</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="table-container">
            <div class="table-header">
                <h5><i class="bi bi-clock-history me-2"></i>Últimas Vendas</h5>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Venda</th>
                            <th>Cliente</th>
                            <th>Valor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UltimasVendas.Any())
                        {
                            @foreach (var v in Model.UltimasVendas)
                            {
                                var badgeClass = v.TpStatus switch
                                {
                                    "FINALIZADA" => "badge-concluido",
                                    "CANCELADA" => "badge-cancelado",
                                    _ => "badge-agendado"
                                };
                                <tr>
                                    <td>#@v.IdVenda</td>
                                    <td>@(v.Cliente?.NmCliente ?? "-")</td>
                                    <td class="text-nowrap"><strong>R$ @v.VlTotal.ToString("N2")</strong></td>
                                    <td><span class="badge-status @badgeClass">@v.TpStatus</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Nenhuma venda encontrada</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Menu de acesso rapido: lista em ordem alfabetica os itens do menu lateral
        // (mesma fonte do menu, entao uma tela nova no menu aparece aqui sozinha)
        (function () {
            const lista = document.getElementById('listaAcesso');
            const vazio = document.getElementById('acessoVazio');
            const busca = document.getElementById('buscaAcesso');
            const semAcento = t => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

            [...document.querySelectorAll('#sidebarNav a.sidebar-link:not([data-aba-principal])')]
                .map(a => ({ nome: a.textContent.trim(), href: a.getAttribute('href'), icone: a.querySelector('i')?.className || 'bi bi-window' }))
                .sort((x, y) => x.nome.localeCompare(y.nome, 'pt-BR'))
                .forEach(i => {
                    const a = document.createElement('a');
                    a.className = 'acesso-item';
                    a.href = i.href;
                    a.setAttribute('data-abrir-aba', '');
                    a.dataset.abaIcone = i.icone;
                    a.innerHTML = '<span><i></i><span></span></span><i class="bi bi-chevron-right"></i>';
                    a.querySelector('span > i').className = i.icone + ' me-2';
                    a.querySelector('span > span').textContent = i.nome;
                    lista.appendChild(a);
                });

            busca.addEventListener('input', function () {
                const q = semAcento(this.value.trim());
                let visiveis = 0;
                lista.querySelectorAll('.acesso-item').forEach(a => {
                    const ok = !q || semAcento(a.textContent).includes(q);
                    a.classList.toggle('d-none', !ok);
                    if (ok) visiveis++;
                });
                vazio.classList.toggle('d-none', visiveis > 0);
            });
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        // Dados reais vindos do banco de dados
        const faturamentoLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FaturamentoSemanaLabels));
        const faturamentoValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FaturamentoSemanaValores));
        const servicosLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServicosLabels));
        const servicosValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServicosValores));

        // Faturamento Semanal - Bar Chart
        new Chart(document.getElementById('chartFaturamento'), {
            type: 'bar',
            data: {
                labels: faturamentoLabels,
                datasets: [{
                    label: 'Faturamento (R$)',
                    data: faturamentoValores,
                    backgroundColor: 'rgba(59, 130, 246, 0.7)',
                    borderColor: '#3b82f6',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => 'R$ ' + v }
                    }
                }
            }
        });

        // Servicos Mais Solicitados - Doughnut Chart
        const servicosCanvas = document.getElementById('chartServicos');
        if (servicosValores.length > 0) {
            new Chart(servicosCanvas, {
                type: 'doughnut',
                data: {
                    labels: servicosLabels,
                    datasets: [{
                        data: servicosValores,
                        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 12, font: { size: 11 } }
                        }
                    }
                }
            });
        } else {
            servicosCanvas.parentElement.innerHTML =
                '<div class="d-flex align-items-center justify-content-center h-100 text-muted">Nenhum serviço registrado no período</div>';
        }
    </script>
}
