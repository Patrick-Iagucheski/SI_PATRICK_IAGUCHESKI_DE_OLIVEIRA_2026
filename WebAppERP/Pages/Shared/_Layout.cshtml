@{
    var curr = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string[] gCadastros = { "/Gerais/Clientes", "/Gerais/Funcionarios", "/Gerais/Cargos", "/Gerais/Servicos", "/Gerais/Fornecedores", "/Gerais/Transportadores" };
    string[] gLocalidades = { "/Gerais/Paises", "/Gerais/Estados", "/Gerais/Cidades" };
    string[] gEstoque = { "/Estoque/Produtos", "/Estoque/Marcas", "/Estoque/Categorias" };
    string[] gFinanceiro = { "/Financeiro/FormasPagamento", "/Financeiro/CondicoesPagamento", "/Financeiro/ContasAPagar" };
    string[] gOperacional = { "/Operacional/Agendamentos", "/Vendas/Vendas", "/Vendas/Venda", "/Compras/Compras", "/Compras/Compra" };
    string[] gVendas = { "/Vendas/Vendas", "/Vendas/Venda" };
    string[] gCompras = { "/Compras/Compras", "/Compras/Compra" };
    string Active(string page) => curr == page ? "active" : "";
    string Open(string[] grupo) => grupo.Contains(curr) ? "" : "collapsed";

    // Nome e logo da empresa vem do banco (tela Configuracoes)
    var empresa = await EmpresaSvc.GetDadosEmpresa();
}
@inject WebAppERP.Infrastructure.EmpresaService EmpresaSvc
<!DOCTYPE html>
<html lang="pt-BR" data-empresa="@empresa.Nome">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @empresa.Nome</title>
    @* Icone da guia do navegador = logo da empresa (Configuracoes) *@
    <link rel="icon" id="iconeEmpresa" href="@Url.Content("~" + empresa.Logo)" />
    <script>
        // Abas internas: dentro de uma aba (iframe) a pagina esconde menu e topo;
        // na janela principal o layout vira o "shell" com a barra de abas.
        // Roda no head para aplicar a classe antes do primeiro desenho da tela.
        document.documentElement.classList.add(window.self !== window.top ? 'em-aba' : 'com-abas');
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebAppERP.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <img src="@Url.Content("~" + empresa.Logo)" alt="@empresa.Nome" class="sidebar-logo" />
                <span class="sidebar-brand">@empresa.Nome</span>
            </div>

            <div class="sidebar-search">
                <i class="bi bi-search"></i>
                <input type="text" id="menuSearch" placeholder="Buscar no menu..." autocomplete="off" />
            </div>

            <ul class="sidebar-nav" id="sidebarNav">
                <li class="sidebar-item">
                    <a class="sidebar-link @Active("/Index")" asp-page="/Index" data-aba-principal>
                        <i class="bi bi-house-door-fill"></i>
                        <span>Principal</span>
                    </a>
                </li>

                <li class="sidebar-group @Open(gCadastros)" data-group>
                    <button type="button" class="sidebar-group-header">
                        <span>Cadastros</span>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </button>
                    <ul class="sidebar-group-items">
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Clientes")" asp-page="/Gerais/Clientes">
                                <i class="bi bi-people-fill"></i><span>Clientes</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Funcionarios")" asp-page="/Gerais/Funcionarios">
                                <i class="bi bi-person-badge-fill"></i><span>Funcionários</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Cargos")" asp-page="/Gerais/Cargos">
                                <i class="bi bi-briefcase-fill"></i><span>Cargos</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Servicos")" asp-page="/Gerais/Servicos">
                                <i class="bi bi-card-checklist"></i><span>Serviços</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Fornecedores")" asp-page="/Gerais/Fornecedores">
                                <i class="bi bi-truck"></i><span>Fornecedores</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Transportadores")" asp-page="/Gerais/Transportadores">
                                <i class="bi bi-truck-front-fill"></i><span>Transportadores</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-group @Open(gLocalidades)" data-group>
                    <button type="button" class="sidebar-group-header">
                        <span>Localidades</span>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </button>
                    <ul class="sidebar-group-items">
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Paises")" asp-page="/Gerais/Paises">
                                <i class="bi bi-globe-americas"></i><span>Países</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Estados")" asp-page="/Gerais/Estados">
                                <i class="bi bi-map"></i><span>Estados</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Gerais/Cidades")" asp-page="/Gerais/Cidades">
                                <i class="bi bi-building"></i><span>Cidades</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-group @Open(gEstoque)" data-group>
                    <button type="button" class="sidebar-group-header">
                        <span>Estoque</span>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </button>
                    <ul class="sidebar-group-items">
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Estoque/Produtos")" asp-page="/Estoque/Produtos">
                                <i class="bi bi-box-seam"></i><span>Produtos</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Estoque/Marcas")" asp-page="/Estoque/Marcas">
                                <i class="bi bi-tags-fill"></i><span>Marcas</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Estoque/Categorias")" asp-page="/Estoque/Categorias">
                                <i class="bi bi-collection-fill"></i><span>Categorias</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-group @Open(gFinanceiro)" data-group>
                    <button type="button" class="sidebar-group-header">
                        <span>Financeiro</span>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </button>
                    <ul class="sidebar-group-items">
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Financeiro/FormasPagamento")" asp-page="/Financeiro/FormasPagamento">
                                <i class="bi bi-credit-card"></i><span>Formas de Pagamento</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Financeiro/CondicoesPagamento")" asp-page="/Financeiro/CondicoesPagamento">
                                <i class="bi bi-list-check"></i><span>Condições de Pagamento</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Financeiro/ContasAPagar")" asp-page="/Financeiro/ContasAPagar">
                                <i class="bi bi-cash-stack"></i><span>Contas a Pagar</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-group @Open(gOperacional)" data-group>
                    <button type="button" class="sidebar-group-header">
                        <span>Operacional</span>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </button>
                    <ul class="sidebar-group-items">
                        <li class="sidebar-item">
                            <a class="sidebar-link @Active("/Operacional/Agendamentos")" asp-page="/Operacional/Agendamentos">
                                <i class="bi bi-calendar-check-fill"></i><span>Agendamentos</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(gVendas.Contains(curr) ? "active" : "")" asp-page="/Vendas/Vendas">
                                <i class="bi bi-cart-check-fill"></i><span>Vendas</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(gCompras.Contains(curr) ? "active" : "")" asp-page="/Compras/Compras">
                                <i class="bi bi-cart-plus-fill"></i><span>Compras</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-empty text-muted small px-3 py-2" id="menuSearchEmpty" style="display:none;">
                    Nenhum item encontrado
                </li>
            </ul>

            <div class="sidebar-footer">
                <i class="bi bi-person-circle"></i>
                <span>Admin</span>
            </div>
        </nav>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100">
            <nav class="navbar navbar-expand-lg navbar-light topbar">
                <div class="container-fluid">
                    <button class="btn btn-link" id="sidebarToggle">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <span class="navbar-text fw-semibold text-muted" id="topbarTitulo">
                        @ViewData["Title"]
                    </span>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                        <div class="topbar-divider"></div>
                        <div class="dropdown">
                            <a class="btn btn-link text-dark text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i> Admin
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-page="/Seguranca/Configuracoes" data-abrir-aba
                                       data-aba-titulo="Configurações" data-aba-icone="bi bi-gear">
                                        <i class="bi bi-gear me-2"></i>Configurações
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
            @* Barra de abas e paineis (iframes): montados pelo site.js so na janela principal.
               Nela o #conteudoPagina fica oculto (o CSS esconde) e a tela aparece no iframe. *@
            <div class="abas-barra" id="abasBarra" role="tablist"></div>
            <div class="abas-conteudo" id="abasConteudo"></div>
            <div class="container-fluid p-4" id="conteudoPagina">
                <main role="main">
                    @* Alertas de TempData centralizados: qualquer pagina que definir
                       TempData["Erro"] ou TempData["Sucesso"] exibe a mensagem aqui,
                       sem precisar repetir o bloco em cada view. *@
                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Erro"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @TempData["Sucesso"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Recolher / expandir secoes (abas)
        document.querySelectorAll('#sidebarNav .sidebar-group-header').forEach(function (btn) {
            btn.addEventListener('click', function () {
                btn.parentElement.classList.toggle('collapsed');
            });
        });

        // Busca no menu
        const menuSearch = document.getElementById('menuSearch');
        const menuEmpty = document.getElementById('menuSearchEmpty');
        menuSearch?.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            let totalVisivel = 0;

            document.querySelectorAll('#sidebarNav .sidebar-group').forEach(function (grupo) {
                let algum = false;
                grupo.querySelectorAll('.sidebar-item').forEach(function (item) {
                    const txt = item.textContent.trim().toLowerCase();
                    const ok = !q || txt.includes(q);
                    item.style.display = ok ? '' : 'none';
                    if (ok) { algum = true; totalVisivel++; }
                });
                // ao buscar, abre os grupos com resultado e esconde os vazios
                if (q) {
                    grupo.style.display = algum ? '' : 'none';
                    grupo.classList.toggle('collapsed', !algum);
                } else {
                    grupo.style.display = '';
                }
            });

            // Dashboard (item solto)
            document.querySelectorAll('#sidebarNav > .sidebar-item').forEach(function (item) {
                const txt = item.textContent.trim().toLowerCase();
                const ok = !q || txt.includes(q);
                item.style.display = ok ? '' : 'none';
                if (ok) totalVisivel++;
            });

            if (menuEmpty) menuEmpty.style.display = (q && totalVisivel === 0) ? '' : 'none';
        });

        // Toggle da sidebar (botao do topo)
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('wrapper').classList.toggle('sidebar-collapsed');
        });

        // Abre um modal por cima de outro SEM usar data-bs-toggle. Isso e necessario
        // porque o handler nativo do data-bs-toggle="modal" do Bootstrap FECHA o modal
        // que ja estava aberto ("avoid conflict when clicking modal toggler while another
        // one is open"). Ao abrir via JS, o modal de baixo (ex.: Produto/Funcionario)
        // permanece aberto e preservado enquanto o cadastro rapido fica por cima.
        window.abrirModalEmpilhado = function (id) {
            var el = document.getElementById(id);
            if (el) bootstrap.Modal.getOrCreateInstance(el).show();
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
