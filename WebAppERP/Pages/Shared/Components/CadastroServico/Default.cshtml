@model WebAppERP.ViewModels.CadastroServicoViewModel
@*
    Componente de cadastro de servico (ViewComponents/CadastroServicoViewComponent).
    Traz o proprio script (Default.cshtml.js, nesta pasta), incluido uma vez por
    pagina. Modo "ajax": o Salvar grava pelo module.js e dispara o evento
    'servico:salvo' (detail: o registro gravado), sem recarregar a tela.
*@

<div class="modal fade" id="modalServico" tabindex="-1"
     data-url-cadastro="@Url.Page("/Gerais/Servicos")" data-url-categorias="@Url.Page("/Gerais/CategoriasServico")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax asp-page="/Gerais/Servicos"
                  asp-page-handler="@(Model.Modo == "ajax" ? "SalvarAjax" : null)"
                  data-evento="@(Model.Modo == "ajax" ? "servico:salvo" : null)">
                <div class="modal-header">
                    <h5 class="modal-title" id="svTitulo"><i class="bi bi-card-checklist me-2"></i>Novo Serviço</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="ServicoForm.IdServico" id="sId" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nome do Serviço *</label>
                            <input type="text" class="form-control" asp-for="ServicoForm.DsServico" id="sNome" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descrição</label>
                            <textarea class="form-control" rows="2" asp-for="ServicoForm.DsDescricao" id="sDesc"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Valor (R$) *</label>
                            <input type="number" class="form-control" asp-for="ServicoForm.VlServico" id="sValor" step="0.01" min="0.01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Duração (min)</label>
                            <input type="number" class="form-control" asp-for="ServicoForm.NrDuracaoMin" id="sDuracao" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoria</label>
                            <select class="form-select" asp-for="ServicoForm.IdCategoriaServico" id="sCat"
                                    data-pesquisa="abrirPesquisaCategoriaServico()" data-titulo-pesquisa="Pesquisar categoria de serviço">
                                <option value="">Selecione</option>
                                @foreach (var categoria in Model.Categorias)
                                {
                                    <option value="@categoria.IdCategoriaServico">@categoria.NmCategoria</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            @* Marcado = inativo. O valor gravado (FlAtivo) vai no campo escondido (definirAtivo, module.js). *@
                            <input type="hidden" asp-for="ServicoForm.FlAtivo" id="sAtivo" />
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="sAtivoInativo" data-inativo-de="sAtivo" checked="@(!Model.ServicoForm.FlAtivo)" />
                                <label class="form-check-label" for="sAtivoInativo">Inativo</label>
                            </div>
                        </div>
                    </div>
                    <partial name="_Registro" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Cadastro Rapido de Categoria de Servico (AJAX) -->
<div class="modal fade" id="modalCategoriaServicoRapido" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-bookmarks me-2"></i><span id="catServTitulo">Cadastrar Categoria de Serviço</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="catServMsg"></div>
                <input type="hidden" id="catServId" value="0" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Categoria *</label>
                        <input type="text" class="form-control" id="catServNome" maxlength="100" placeholder="Ex: Corte" />
                    </div>
                </div>
                <partial name="_Registro" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnSalvarCategoriaServicoRapido" onclick="salvarCategoriaServico()">
                    <i class="bi bi-check-lg me-1"></i>Salvar Categoria
                </button>
            </div>
        </div>
    </div>
</div>

@if (Model.IncluirScript)
{
    <script src="~/Pages/Shared/Components/CadastroServico/Default.cshtml.js" asp-append-version="true"></script>
}
