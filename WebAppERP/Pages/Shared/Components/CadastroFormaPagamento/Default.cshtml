@model WebAppERP.ViewModels.CadastroFormaPagamentoViewModel
@*
    Componente de cadastro de forma de pagamento (ViewComponents/CadastroFormaPagamentoViewComponent).
    Traz o proprio script (Default.cshtml.js, nesta pasta), incluido uma vez por
    pagina. Modo "ajax": o Salvar grava pelo module.js e dispara o evento
    'forma:salva' (detail: o registro gravado), sem recarregar a tela.
*@

<div class="modal fade" id="modalForma" tabindex="-1"
     data-url-cadastro="@Url.Page("/Financeiro/FormasPagamento")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax asp-page="/Financeiro/FormasPagamento"
                  asp-page-handler="@(Model.Modo == "ajax" ? "SalvarAjax" : null)"
                  data-evento="@(Model.Modo == "ajax" ? "forma:salva" : null)">
                <div class="modal-header">
                    <h5 class="modal-title" id="fpTitulo"><i class="bi bi-credit-card me-2"></i>Nova Forma de Pagamento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="FormaForm.IdFormaPagamento" id="fpId" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Descrição *</label>
                            <input type="text" class="form-control" asp-for="FormaForm.DsFormaPagamento" id="fpNome" maxlength="50" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Status</label>
                            @* Marcado = inativo. O valor gravado (FlAtivo) vai no campo escondido (definirAtivo, module.js). *@
                            <input type="hidden" asp-for="FormaForm.FlAtivo" id="fpAtivo" />
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="fpAtivoInativo" data-inativo-de="fpAtivo" checked="@(!Model.FormaForm.FlAtivo)" />
                                <label class="form-check-label" for="fpAtivoInativo">Inativo</label>
                            </div>
                        </div>
                    </div>
                    <partial name="_Registro" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.IncluirScript)
{
    <script src="~/Pages/Shared/Components/CadastroFormaPagamento/Default.cshtml.js" asp-append-version="true"></script>
}
