@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

@* Pagina mostrada quando acontece um erro inesperado (fora do modo de
   desenvolvimento). Nao mostra detalhes tecnicos para o usuario; o codigo
   abaixo serve para localizar o erro no log. *@
<div class="card border-0 shadow-sm mx-auto mt-4" style="max-width: 560px;">
    <div class="card-body p-4 text-center">
        <i class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i>
        <h4 class="mt-3 mb-2">Não foi possível concluir a operação</h4>
        <p class="text-muted mb-3">
            Aconteceu um erro inesperado. Nenhuma informação foi perdida além do que estava
            sendo feito agora. Volte e tente novamente; se o erro continuar, avise o suporte.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-3">Código do erro: <code>@Model.RequestId</code></p>
        }

        <a class="btn btn-primary" href="javascript:history.back()"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
    </div>
</div>
