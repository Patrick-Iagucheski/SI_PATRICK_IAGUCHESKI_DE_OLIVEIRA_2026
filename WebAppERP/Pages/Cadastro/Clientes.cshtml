@page
@model WebAppERP.Pages.Cadastro.ClientesModel
@{
    ViewData["Title"] = "Clientes";

    string FormatarCPF(string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        return d.Length == 11
            ? $"{d[..3]}.{d.Substring(3, 3)}.{d.Substring(6, 3)}-{d.Substring(9, 2)}"
            : (string.IsNullOrEmpty(v) ? "" : v);
    }

    string FormatarCNPJ(string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        return d.Length == 14
            ? $"{d[..2]}.{d.Substring(2, 3)}.{d.Substring(5, 3)}/{d.Substring(8, 4)}-{d.Substring(12, 2)}"
            : (string.IsNullOrEmpty(v) ? "" : v);
    }

    string FormatarTelefone(string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        if (d.Length == 11) return $"({d[..2]}) {d.Substring(2, 5)}-{d.Substring(7, 4)}";
        if (d.Length == 10) return $"({d[..2]}) {d.Substring(2, 4)}-{d.Substring(6, 4)}";
        return string.IsNullOrEmpty(v) ? "-" : v;
    }

    string TipoPessoaLabel(string? t) => t switch
    {
        "J" => "Juridica",
        "E" => "Estrangeiro",
        _ => "Fisica"
    };

    string DocumentoExibicao(WebAppERP.Models.GerCliente c) => c.TpPessoa switch
    {
        "J" => FormatarCNPJ(c.NrCnpj),
        "E" => c.NrDocumento ?? "",
        _ => FormatarCPF(c.NrCpf)
    };
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Clientes</h1>
        <p class="page-subtitle">Gerencie os clientes cadastrados no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCliente" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Novo Cliente
    </button>
</div>

@if (TempData["ErroCliente"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErroCliente"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Nome</label>
                <input type="text" class="form-control" id="buscaNome" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">CPF / CNPJ / Documento</label>
                <input type="text" class="form-control" id="buscaDocumento" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">E-mail</label>
                <input type="text" class="form-control" id="buscaEmail" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="buscaInativos" onchange="buscarClientes()" />
                <label class="form-check-label" for="buscaInativos">Exibir Clientes Inativos</label>
            </div>
            <button type="button" class="btn btn-primary" onclick="buscarClientes()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-people-fill me-2"></i>Lista de Clientes</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Clientes.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblClientes">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>CPF / CNPJ</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th>Cidade</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clientes.Any())
                {
                    @foreach (var c in Model.Clientes)
                    {
                        <tr>
                            <td>@c.IdCliente</td>
                            <td><strong>@c.NmCliente</strong></td>
                            <td>@TipoPessoaLabel(c.TpPessoa)</td>
                            <td class="text-nowrap">@(string.IsNullOrEmpty(DocumentoExibicao(c)) ? "-" : DocumentoExibicao(c))</td>
                            <td class="text-nowrap">@FormatarTelefone(c.NrTelefone)</td>
                            <td>@(c.DsEmail ?? "-")</td>
                            <td>@(c.Cidade != null ? $"{c.Cidade.NmCidade}/{c.Cidade.Estado?.SgUF}" : "-")</td>
                            <td>
                                @if (c.FlAtivo)
                                {
                                    <span class="badge-status badge-ativo">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inativo">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalCliente"
                                        onclick="editarCliente(@c.IdCliente,'@c.NmCliente.Replace("'", "\\'")','@c.TpPessoa','@c.NrCpf','@c.NrCnpj','@c.NrDocumento?.Replace("'", "\\'")','@c.NrRG','@c.NrTelefone','@c.DsEmail','@c.DsEndereco?.Replace("'", "\\'")','@c.NrNumero','@c.DsComplemento?.Replace("'", "\\'")','@c.DsBairro?.Replace("'", "\\'")','@(c.IdCidade?.ToString() ?? "")','@c.NrCEP','@(c.DtNascimento?.ToString("yyyy-MM-dd") ?? "")','@c.DsSexo','@c.DsObservacao?.Replace("'", "\\'")','@c.FlAtivo')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este cliente?')">
                                    <input type="hidden" name="id" value="@c.IdCliente" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Nenhum cliente cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar Cliente -->
<div class="modal fade" id="modalCliente" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-person-plus me-2"></i>Novo Cliente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="ClienteForm.IdCliente" id="formIdCliente" />
                    <div class="row g-3">
                        <!-- Codigo (somente leitura) | Tipo de Pessoa | Nome -->
                        <div class="col-md-2">
                            <label class="form-label">Código</label>
                            <input type="text" class="form-control bg-light" id="formCodigoDisplay" placeholder="(novo)" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tipo de Pessoa *</label>
                            <select class="form-select" asp-for="ClienteForm.TpPessoa" id="formTpPessoa" onchange="toggleTipoPessoa()">
                                <option value="F">Pessoa Física</option>
                                <option value="J">Pessoa Jurídica</option>
                                <option value="E">Estrangeiro / Outro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" id="lblNome">Nome Completo *</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NmCliente" id="formNmCliente" maxlength="200" required />
                        </div>

                        <!-- Documento (CPF / CNPJ / Outro) | RG | Sexo | Nascimento -->
                        <div class="col-md-3" id="wrapCpf">
                            <label class="form-label">CPF</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrCpf" id="formNrCpf" maxlength="14" placeholder="000.000.000-00" />
                        </div>
                        <div class="col-md-3 d-none" id="wrapCnpj">
                            <label class="form-label">CNPJ</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrCnpj" id="formNrCnpj" maxlength="18" placeholder="00.000.000/0000-00" />
                        </div>
                        <div class="col-md-3 d-none" id="wrapDoc">
                            <label class="form-label">Documento</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrDocumento" id="formNrDocumento" maxlength="30" placeholder="Documento" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">RG</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrRG" id="formNrRG" maxlength="12" placeholder="00.000.000-0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Sexo</label>
                            <select class="form-select" asp-for="ClienteForm.DsSexo" id="formDsSexo">
                                <option value="">Selecione</option>
                                <option value="M">Masculino</option>
                                <option value="F">Feminino</option>
                                <option value="O">Outro</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Data de Nascimento</label>
                            <input type="date" class="form-control" asp-for="ClienteForm.DtNascimento" id="formDtNascimento" />
                        </div>

                        <!-- Telefone | E-mail -->
                        <div class="col-md-4">
                            <label class="form-label">Telefone</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrTelefone" id="formNrTelefone" maxlength="15" placeholder="(00) 00000-0000" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">E-mail</label>
                            <input type="email" class="form-control" asp-for="ClienteForm.DsEmail" id="formDsEmail" maxlength="150" />
                        </div>

                        <!-- Endereco | Numero -->
                        <div class="col-md-8">
                            <label class="form-label">Endereço</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.DsEndereco" id="formDsEndereco" maxlength="200" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Número</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrNumero" id="formNrNumero" maxlength="10" />
                        </div>

                        <!-- Complemento | Bairro -->
                        <div class="col-md-6">
                            <label class="form-label">Complemento</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.DsComplemento" id="formDsComplemento" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Bairro</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.DsBairro" id="formDsBairro" maxlength="100" />
                        </div>

                        <!-- Cidade (cadastro rapido) | CEP | Status -->
                        <div class="col-md-6">
                            <label class="form-label">Cidade</label>
                            @await Component.InvokeAsync("CampoCidade", new { nome = "ClienteForm.IdCidade", id = "formIdCidade", idCidade = Model.ClienteForm.IdCidade })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CEP</label>
                            <input type="text" class="form-control" asp-for="ClienteForm.NrCEP" id="formNrCEP" maxlength="9" placeholder="00000-000" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" asp-for="ClienteForm.FlAtivo" id="formFlAtivo">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                        </div>

                        <!-- Observacoes -->
                        <div class="col-12">
                            <label class="form-label">Observações</label>
                            <textarea class="form-control" rows="2" asp-for="ClienteForm.DsObservacao" id="formDsObservacao" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Token antiforgery para as chamadas AJAX (form isolado, fora do form de cliente) -->
<form id="formTokenAjax" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        // ===== Mascaras (somente exibicao; no banco salva so numeros) =====
        function mascaraCPF(v) {
            return v.replace(/\D/g, '').slice(0, 11)
                .replace(/^(\d{3})(\d)/, '$1.$2')
                .replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3')
                .replace(/\.(\d{3})(\d)/, '.$1-$2');
        }
        function mascaraCNPJ(v) {
            return v.replace(/\D/g, '').slice(0, 14)
                .replace(/^(\d{2})(\d)/, '$1.$2')
                .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
                .replace(/\.(\d{3})(\d)/, '.$1/$2')
                .replace(/(\d{4})(\d)/, '$1-$2');
        }
        function mascaraCEP(v) {
            return v.replace(/\D/g, '').slice(0, 8).replace(/^(\d{5})(\d)/, '$1-$2');
        }
        function mascaraTelefone(v) {
            v = v.replace(/\D/g, '').slice(0, 11);
            if (v.length > 10)
                return v.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
            return v.replace(/^(\d{2})(\d{4})(\d{0,4}).*/, '($1) $2-$3').trim();
        }
        function mascaraRG(v) {
            return v.replace(/\D/g, '').slice(0, 9)
                .replace(/^(\d{2})(\d)/, '$1.$2')
                .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
                .replace(/\.(\d{3})(\d)/, '.$1-$2');
        }
        function aplicarMascara(id, fn) {
            const el = document.getElementById(id);
            el?.addEventListener('input', () => { el.value = fn(el.value); });
        }
        aplicarMascara('formNrCpf', mascaraCPF);
        aplicarMascara('formNrCnpj', mascaraCNPJ);
        aplicarMascara('formNrCEP', mascaraCEP);
        aplicarMascara('formNrTelefone', mascaraTelefone);
        aplicarMascara('formNrRG', mascaraRG);

        // ===== Validacao de CPF / CNPJ (digitos verificadores) =====
        function cpfValido(cpf) {
            const d = (cpf || '').replace(/\D/g, '');
            if (d.length !== 11 || /^(\d)\1{10}$/.test(d)) return false;
            const calc = (qtd) => {
                let s = 0;
                for (let i = 0; i < qtd; i++) s += parseInt(d[i]) * (qtd + 1 - i);
                const r = s % 11;
                return r < 2 ? 0 : 11 - r;
            };
            return calc(9) === parseInt(d[9]) && calc(10) === parseInt(d[10]);
        }
        function cnpjValido(cnpj) {
            const d = (cnpj || '').replace(/\D/g, '');
            if (d.length !== 14 || /^(\d)\1{13}$/.test(d)) return false;
            const calc = (qtd, pesos) => {
                let s = 0;
                for (let i = 0; i < qtd; i++) s += parseInt(d[i]) * pesos[i];
                const r = s % 11;
                return r < 2 ? 0 : 11 - r;
            };
            const p1 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
            const p2 = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
            return calc(12, p1) === parseInt(d[12]) && calc(13, p2) === parseInt(d[13]);
        }

        // ===== Tipo de Pessoa: alterna o documento exibido =====
        function toggleTipoPessoa() {
            const tipo = document.getElementById('formTpPessoa').value;
            const wrapCpf = document.getElementById('wrapCpf');
            const wrapCnpj = document.getElementById('wrapCnpj');
            const wrapDoc = document.getElementById('wrapDoc');
            const lblNome = document.getElementById('lblNome');

            wrapCpf.classList.toggle('d-none', tipo !== 'F');
            wrapCnpj.classList.toggle('d-none', tipo !== 'J');
            wrapDoc.classList.toggle('d-none', tipo !== 'E');

            lblNome.textContent = tipo === 'J' ? 'Razao Social *' : 'Nome Completo *';
        }

        // ===== Validacao do formulario antes de enviar =====
        document.querySelector('#modalCliente form')?.addEventListener('submit', function (e) {
            const tipo = document.getElementById('formTpPessoa').value;
            const cpf = document.getElementById('formNrCpf').value;
            const cnpj = document.getElementById('formNrCnpj').value;
            const email = document.getElementById('formDsEmail').value.trim();

            if (tipo === 'F' && cpf.replace(/\D/g, '') && !cpfValido(cpf)) {
                e.preventDefault();
                alert('CPF invalido. Verifique os numeros informados.');
                return;
            }
            if (tipo === 'J' && cnpj.replace(/\D/g, '') && !cnpjValido(cnpj)) {
                e.preventDefault();
                alert('CNPJ invalido. Verifique os numeros informados.');
                return;
            }
            if (email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                e.preventDefault();
                alert('E-mail invalido. Verifique o formato (exemplo: nome@@dominio.com).');
                return;
            }
        });

        function limparForm() {
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-person-plus me-2"></i>Novo Cliente';
            ['formNmCliente','formNrCpf','formNrCnpj','formNrDocumento','formNrRG','formNrTelefone','formDsEmail','formDsEndereco','formNrNumero','formDsComplemento','formDsBairro','formNrCEP','formDtNascimento','formDsSexo','formDsObservacao','formCodigoDisplay'].forEach(id => {
                document.getElementById(id).value = '';
            });
            document.getElementById('formIdCliente').value = '0';
            document.getElementById('formTpPessoa').value = 'F';
            document.getElementById('formFlAtivo').value = 'true';
            limparCidade('formIdCidade');
            toggleTipoPessoa();
        }

        function editarCliente(id, nome, tipo, cpf, cnpj, doc, rg, tel, email, end, numero, complemento, bairro, cidade, cep, nasc, sexo, obs, ativo) {
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Cliente';
            document.getElementById('formIdCliente').value = id;
            document.getElementById('formCodigoDisplay').value = id;
            document.getElementById('formNmCliente').value = nome;
            document.getElementById('formTpPessoa').value = tipo || 'F';
            document.getElementById('formNrCpf').value = mascaraCPF(cpf || '');
            document.getElementById('formNrCnpj').value = mascaraCNPJ(cnpj || '');
            document.getElementById('formNrDocumento').value = doc || '';
            document.getElementById('formNrRG').value = mascaraRG(rg || '');
            document.getElementById('formNrTelefone').value = mascaraTelefone(tel || '');
            document.getElementById('formDsEmail').value = email || '';
            document.getElementById('formDsEndereco').value = end || '';
            document.getElementById('formNrNumero').value = numero || '';
            document.getElementById('formDsComplemento').value = complemento || '';
            document.getElementById('formDsBairro').value = bairro || '';
            definirCidade('formIdCidade', cidade);
            document.getElementById('formNrCEP').value = mascaraCEP(cep || '');
            document.getElementById('formDtNascimento').value = nasc || '';
            document.getElementById('formDsSexo').value = sexo || '';
            document.getElementById('formDsObservacao').value = obs || '';
            document.getElementById('formFlAtivo').value = ativo === 'True' ? 'true' : 'false';
            toggleTipoPessoa();
        }

        // ===== Busca de Clientes (filtros na pagina -> atualiza a grid via AJAX) =====
        let resultadosBusca = [];

        aplicarMascara('buscaDocumento', mascaraCPF);
        ['buscaId', 'buscaNome', 'buscaDocumento', 'buscaEmail'].forEach(id => {
            document.getElementById(id)?.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); buscarClientes(); }
            });
        });

        function statusBadge(ativo) {
            return ativo
                ? '<span class="badge-status badge-ativo">Ativo</span>'
                : '<span class="badge-status badge-inativo">Inativo</span>';
        }

        function tipoLabel(t) {
            if (t === 'J') return 'Juridica';
            if (t === 'E') return 'Estrangeiro';
            return 'Fisica';
        }

        function documentoExibicao(f) {
            if (f.tipoPessoa === 'J') return f.cnpj ? mascaraCNPJ(f.cnpj) : '-';
            if (f.tipoPessoa === 'E') return f.documento || '-';
            return f.cpf ? mascaraCPF(f.cpf) : '-';
        }

        function montarLinha(f, i, token) {
            return '<tr>' +
                '<td>' + f.id + '</td>' +
                '<td><strong>' + (f.nome || '') + '</strong></td>' +
                '<td>' + tipoLabel(f.tipoPessoa) + '</td>' +
                '<td class="text-nowrap">' + documentoExibicao(f) + '</td>' +
                '<td class="text-nowrap">' + (f.tel ? mascaraTelefone(f.tel) : '-') + '</td>' +
                '<td>' + (f.email || '-') + '</td>' +
                '<td>' + (f.cidadeNome || '-') + '</td>' +
                '<td>' + statusBadge(f.ativo) + '</td>' +
                '<td class="text-center">' +
                    '<button class="btn btn-icon btn-outline-primary" title="Editar" onclick="abrirEdicao(' + i + ')"><i class="bi bi-pencil"></i></button> ' +
                    '<form method="post" action="?handler=Delete" class="d-inline" onsubmit="return confirm(\'Deseja realmente excluir este cliente?\')">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + token + '">' +
                        '<input type="hidden" name="id" value="' + f.id + '">' +
                        '<button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>' +
                    '</form>' +
                '</td>' +
            '</tr>';
        }

        async function buscarClientes() {
            const tbody = document.querySelector('#tblClientes tbody');
            const id = document.getElementById('buscaId').value.trim();
            const nome = document.getElementById('buscaNome').value.trim();
            const documento = document.getElementById('buscaDocumento').value.trim();
            const email = document.getElementById('buscaEmail').value.trim();
            const inativos = document.getElementById('buscaInativos').checked;

            const params = new URLSearchParams();
            if (id) params.append('id', id);
            if (nome) params.append('nome', nome);
            if (documento) params.append('documento', documento);
            if (email) params.append('email', email);
            params.append('incluirInativos', inativos);

            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-3">Buscando...</td></tr>';
            try {
                const resp = await fetch('?handler=BuscarClientes&' + params.toString());
                resultadosBusca = await resp.json();

                const contador = document.getElementById('contadorRegistros');
                if (contador) contador.textContent = resultadosBusca.length + ' registros encontrados';

                if (!resultadosBusca.length) {
                    tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">Nenhum cliente encontrado</td></tr>';
                    return;
                }

                const token = document.querySelector('#formTokenAjax input[name="__RequestVerificationToken"]').value;
                tbody.innerHTML = resultadosBusca.map((f, i) => montarLinha(f, i, token)).join('');
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center text-danger py-4">Erro ao buscar. Tente novamente.</td></tr>';
            }
        }

        function abrirEdicao(i) {
            const f = resultadosBusca[i];
            editarCliente(
                f.id, f.nome || '', f.tipoPessoa || 'F', f.cpf || '', f.cnpj || '', f.documento || '',
                f.rg || '', f.tel || '', f.email || '', f.end || '', f.numero || '', f.complemento || '',
                f.bairro || '', (f.idCidade ?? ''), f.cep || '', f.nasc || '', f.sexo || '',
                f.obs || '', (f.ativo ? 'True' : 'False')
            );
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCliente')).show();
        }
    </script>
}
