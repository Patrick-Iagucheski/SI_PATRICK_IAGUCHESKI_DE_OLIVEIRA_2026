@page
@model WebAppERP.Pages.Cadastro.FornecedoresModel
@{
    ViewData["Title"] = "Fornecedores";

    string FormatarCPF(string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        return d.Length == 11 ? $"{d[..3]}.{d.Substring(3, 3)}.{d.Substring(6, 3)}-{d.Substring(9, 2)}" : (v ?? "");
    }
    string FormatarCNPJ(string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        return d.Length == 14 ? $"{d[..2]}.{d.Substring(2, 3)}.{d.Substring(5, 3)}/{d.Substring(8, 4)}-{d.Substring(12, 2)}" : (v ?? "");
    }
    string FormatarTelefone(string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        if (d.Length == 11) return $"({d[..2]}) {d.Substring(2, 5)}-{d.Substring(7, 4)}";
        if (d.Length == 10) return $"({d[..2]}) {d.Substring(2, 4)}-{d.Substring(6, 4)}";
        return string.IsNullOrEmpty(v) ? "-" : v;
    }
    string DocExib(WebAppERP.Models.GerFornecedor f) => f.TpPessoa switch
    {
        "F" => FormatarCPF(f.NrCpf),
        "E" or "O" => f.NrDocumento ?? "",
        _ => FormatarCNPJ(f.NrCNPJ)
    };
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Fornecedores</h1>
        <p class="page-subtitle">Gerencie os fornecedores cadastrados no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalFornecedor" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Novo Fornecedor
    </button>
</div>

@if (TempData["ErroFornecedor"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErroFornecedor"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Razão Social</label>
                <input type="text" class="form-control" id="buscaRazao" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Nome Fantasia</label>
                <input type="text" class="form-control" id="buscaFantasia" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">CPF / CNPJ</label>
                <input type="text" class="form-control" id="buscaDocumento" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="buscaInativos" onchange="buscarFornecedores()" />
                <label class="form-check-label" for="buscaInativos">Exibir Fornecedores Inativos</label>
            </div>
            <button type="button" class="btn btn-primary" onclick="buscarFornecedores()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-truck me-2"></i>Lista de Fornecedores</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Fornecedores.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblFornecedores">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Razão Social</th>
                    <th>Nome Fantasia</th>
                    <th>CPF / CNPJ</th>
                    <th>Telefone</th>
                    <th>Cidade</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Fornecedores.Any())
                {
                    @foreach (var f in Model.Fornecedores)
                    {
                        <tr>
                            <td>@f.IdFornecedor</td>
                            <td><strong>@f.DsRazaoSocial</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(f.DsNomeFantasia) ? "-" : f.DsNomeFantasia)</td>
                            <td>@(string.IsNullOrEmpty(DocExib(f)) ? "-" : DocExib(f))</td>
                            <td>@FormatarTelefone(f.NrCelular ?? f.NrTelefoneFixo)</td>
                            <td>@(f.Cidade != null ? $"{f.Cidade.NmCidade}/{f.Cidade.Estado?.SgUF}" : "-")</td>
                            <td>
                                @if (f.FlAtivo)
                                {
                                    <span class="badge-status badge-ativo">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inativo">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalFornecedor"
                                        onclick="editarPorId(@f.IdFornecedor)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este fornecedor?')">
                                    <input type="hidden" name="id" value="@f.IdFornecedor" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Nenhum fornecedor cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar Fornecedor + cadastros rapidos (componente compartilhado com a Compra) -->
@await Component.InvokeAsync("CadastroFornecedor", new { modo = "post", form = Model.FornecedorForm })

<!-- Token antiforgery para as chamadas AJAX -->
<form id="formTokenAjax" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="~/js/cadastro-fornecedor.js" asp-append-version="true"></script>
    <script>
        // Dados dos fornecedores ja carregados na pagina (para edicao das linhas iniciais)
        const dadosIniciais = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Fornecedores.Select(f => new {
            id = f.IdFornecedor, tipoPessoa = f.TpPessoa, razaoSocial = f.DsRazaoSocial, nomeFantasia = f.DsNomeFantasia,
            contatoPrincipal = f.DsContatoPrincipal, cpf = f.NrCpf, cnpj = f.NrCNPJ, documento = f.NrDocumento,
            inscEstadual = f.NrInscEstadual, inscMunicipal = f.NrInscMunicipal, rg = f.NrRG,
            dataNascimento = f.DtNascimento != null ? f.DtNascimento.Value.ToString("yyyy-MM-dd") : null,
            email = f.DsEmail, observacao = f.DsObservacao,
            cep = f.NrCEP, endereco = f.DsEndereco, numero = f.NrNumero, complemento = f.DsComplemento, bairro = f.DsBairro,
            idCidade = f.IdCidade, idCondicaoPagamento = f.IdCondicaoPagamento, cidadeNome =f.Cidade != null ? f.Cidade.NmCidade + " / " + f.Cidade.Estado?.SgUF : null,
            telefoneFixo = f.NrTelefoneFixo, celular = f.NrCelular, whatsApp = f.NrWhatsApp,
            banco = f.DsBanco, agencia = f.NrAgencia, tipoConta = f.TpConta, conta = f.NrConta, digitoConta = f.NrDigitoConta,
            tipoChavePix = f.TpChavePix, chavePix = f.DsChavePix, ativo = f.FlAtivo
        })));

        let resultadosBusca = [];

        function editarPorId(id) {
            const f = dadosIniciais.find(x => x.id === id);
            if (f) editarFornecedor(f);
        }

        function abrirEdicao(i) {
            editarFornecedor(resultadosBusca[i]);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalFornecedor')).show();
        }

        // ===== Busca de Fornecedores via AJAX =====
        aplicarMascara('buscaDocumento', mascaraCNPJ);
        ['buscaId', 'buscaRazao', 'buscaFantasia', 'buscaDocumento'].forEach(id => {
            document.getElementById(id)?.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); buscarFornecedores(); }
            });
        });

        function statusBadge(ativo) {
            return ativo ? '<span class="badge-status badge-ativo">Ativo</span>' : '<span class="badge-status badge-inativo">Inativo</span>';
        }
        function documentoExibicao(f) {
            if (f.tipoPessoa === 'F') return f.cpf ? mascaraCPF(f.cpf) : '-';
            if (f.tipoPessoa === 'E' || f.tipoPessoa === 'O') return f.documento || '-';
            return f.cnpj ? mascaraCNPJ(f.cnpj) : '-';
        }

        function montarLinha(f, i, token) {
            const tel = f.celular || f.telefoneFixo;
            return '<tr>' +
                '<td>' + f.id + '</td>' +
                '<td><strong>' + (f.razaoSocial || '') + '</strong></td>' +
                '<td>' + (f.nomeFantasia || '-') + '</td>' +
                '<td>' + documentoExibicao(f) + '</td>' +
                '<td>' + (tel ? mascaraTelefone(tel) : '-') + '</td>' +
                '<td>' + (f.cidadeNome || '-') + '</td>' +
                '<td>' + statusBadge(f.ativo) + '</td>' +
                '<td class="text-center">' +
                    '<button class="btn btn-icon btn-outline-primary" title="Editar" onclick="abrirEdicao(' + i + ')"><i class="bi bi-pencil"></i></button> ' +
                    '<form method="post" action="?handler=Delete" class="d-inline" onsubmit="return confirm(\'Deseja realmente excluir este fornecedor?\')">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + token + '">' +
                        '<input type="hidden" name="id" value="' + f.id + '">' +
                        '<button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>' +
                    '</form>' +
                '</td>' +
            '</tr>';
        }

        async function buscarFornecedores() {
            const tbody = document.querySelector('#tblFornecedores tbody');
            const id = document.getElementById('buscaId').value.trim();
            const razao = document.getElementById('buscaRazao').value.trim();
            const fantasia = document.getElementById('buscaFantasia').value.trim();
            const documento = document.getElementById('buscaDocumento').value.trim();
            const inativos = document.getElementById('buscaInativos').checked;

            const params = new URLSearchParams();
            if (id) params.append('id', id);
            if (razao) params.append('razao', razao);
            if (fantasia) params.append('fantasia', fantasia);
            if (documento) params.append('documento', documento);
            params.append('incluirInativos', inativos);

            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Buscando...</td></tr>';
            try {
                const resp = await fetch('?handler=BuscarFornecedores&' + params.toString());
                resultadosBusca = await resp.json();

                const contador = document.getElementById('contadorRegistros');
                if (contador) contador.textContent = resultadosBusca.length + ' registros encontrados';

                if (!resultadosBusca.length) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Nenhum fornecedor encontrado</td></tr>';
                    return;
                }
                const token = document.querySelector('#formTokenAjax input[name="__RequestVerificationToken"]').value;
                tbody.innerHTML = resultadosBusca.map((f, i) => montarLinha(f, i, token)).join('');
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Erro ao buscar. Tente novamente.</td></tr>';
            }
        }
    </script>
}
