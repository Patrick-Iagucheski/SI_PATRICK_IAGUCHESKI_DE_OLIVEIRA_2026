@page
@model WebAppERP.Pages.Cadastro.CategoriasModel
@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Categorias</h1>
        <p class="page-subtitle">Cadastre categorias para classificar os produtos do estoque</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCategoria" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Nova Categoria
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-6">
                <label class="form-label small mb-1">Categoria</label>
                <input type="text" class="form-control" id="buscaTermo" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="buscaInativos" onchange="buscarCategorias()" />
                <label class="form-check-label" for="buscaInativos">Exibir Categorias Inativas</label>
            </div>
            <button type="button" class="btn btn-primary" onclick="buscarCategorias()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-collection-fill me-2"></i>Lista de Categorias</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Categorias.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblCategorias">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Categoria</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categorias.Any())
                {
                    @foreach (var c in Model.Categorias)
                    {
                        <tr data-status="@(c.FlAtivo ? "ativo" : "inativo")">
                            <td>@c.IdCategoria</td>
                            <td><strong>@c.NmCategoria</strong></td>
                            <td>
                                @if (c.FlAtivo)
                                {
                                    <span class="badge-status badge-ativo">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inativo">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalCategoria"
                                        onclick="editarCategoria(@c.IdCategoria,'@c.NmCategoria.Replace("'", "\\'")','@c.FlAtivo')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Deseja realmente excluir esta categoria?')">
                                    <input type="hidden" name="id" value="@c.IdCategoria" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Nenhuma categoria cadastrada</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Token antiforgery para as chamadas AJAX -->
<form id="formTokenAjax" class="d-none">@Html.AntiForgeryToken()</form>

<!-- Modal -->
<div class="modal fade" id="modalCategoria" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-collection me-2"></i>Nova Categoria</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="CategoriaForm.IdCategoria" id="cId" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Código</label>
                            <input type="text" class="form-control bg-light" id="cCodigoDisplay" placeholder="(novo)" readonly />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Categoria *</label>
                            <input type="text" class="form-control" asp-for="CategoriaForm.NmCategoria" id="cNome" maxlength="100" placeholder="Ex: Bebida" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Status</label>
                            <select class="form-select" asp-for="CategoriaForm.FlAtivo" id="cAtivo">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===== Busca de Categorias (filtros na pagina -> atualiza a grid via AJAX) =====
        let resultadosBusca = [];

        ['buscaId', 'buscaTermo'].forEach(id => {
            document.getElementById(id)?.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); buscarCategorias(); }
            });
        });

        function statusBadge(ativo) {
            return ativo
                ? '<span class="badge-status badge-ativo">Ativo</span>'
                : '<span class="badge-status badge-inativo">Inativo</span>';
        }

        function montarLinha(c, i, token) {
            return '<tr>' +
                '<td>' + c.id + '</td>' +
                '<td><strong>' + (c.nome || '') + '</strong></td>' +
                '<td>' + statusBadge(c.ativo) + '</td>' +
                '<td class="text-center">' +
                    '<button class="btn btn-icon btn-outline-primary" title="Editar" onclick="abrirEdicao(' + i + ')"><i class="bi bi-pencil"></i></button> ' +
                    '<form method="post" action="?handler=Delete" class="d-inline" onsubmit="return confirm(\'Deseja realmente excluir esta categoria?\')">' +
                        '<input type="hidden" name="__RequestVerificationToken" value="' + token + '">' +
                        '<input type="hidden" name="id" value="' + c.id + '">' +
                        '<button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>' +
                    '</form>' +
                '</td>' +
            '</tr>';
        }

        async function buscarCategorias() {
            const tbody = document.querySelector('#tblCategorias tbody');
            const id = document.getElementById('buscaId').value.trim();
            const termo = document.getElementById('buscaTermo').value.trim();
            const inativos = document.getElementById('buscaInativos').checked;

            const params = new URLSearchParams();
            if (id) params.append('id', id);
            if (termo) params.append('termo', termo);
            params.append('incluirInativos', inativos);

            tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Buscando...</td></tr>';
            try {
                const resp = await fetch('?handler=BuscarCategorias&' + params.toString());
                resultadosBusca = await resp.json();

                const contador = document.getElementById('contadorRegistros');
                if (contador) contador.textContent = resultadosBusca.length + ' registros encontrados';

                if (!resultadosBusca.length) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">Nenhuma categoria encontrada</td></tr>';
                    return;
                }

                const token = document.querySelector('#formTokenAjax input[name="__RequestVerificationToken"]').value;
                tbody.innerHTML = resultadosBusca.map((c, i) => montarLinha(c, i, token)).join('');
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger py-4">Erro ao buscar. Tente novamente.</td></tr>';
            }
        }

        function abrirEdicao(i) {
            const c = resultadosBusca[i];
            editarCategoria(c.id, c.nome || '', (c.ativo ? 'True' : 'False'));
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCategoria')).show();
        }

        // ===== Modal (novo / editar) =====
        function limparForm() {
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-collection me-2"></i>Nova Categoria';
            document.getElementById('cId').value = '0';
            document.getElementById('cCodigoDisplay').value = '';
            document.getElementById('cNome').value = '';
            document.getElementById('cAtivo').value = 'true';
        }

        function editarCategoria(id, nome, ativo) {
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Categoria';
            document.getElementById('cId').value = id;
            document.getElementById('cCodigoDisplay').value = id;
            document.getElementById('cNome').value = nome;
            document.getElementById('cAtivo').value = ativo === 'True' ? 'true' : 'false';
        }
    </script>
}
