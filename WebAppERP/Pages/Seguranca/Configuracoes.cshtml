@page
@model WebAppERP.Pages.Seguranca.ConfiguracoesModel
@{
    ViewData["Title"] = "Configurações";
    var logoAtual = Url.Content("~" + (string.IsNullOrEmpty(Model.DsLogo) ? WebAppERP.Infrastructure.EmpresaService.LogoPadrao : Model.DsLogo));
    var logoPadrao = Url.Content("~" + WebAppERP.Infrastructure.EmpresaService.LogoPadrao);
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Configurações</h1>
        <p class="page-subtitle">Dados da empresa exibidos no sistema</p>
    </div>
</div>

@if (!Model.TabelaCriada)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i>
        A tabela de configurações ainda não existe no banco. Rode o script <strong>Database/CriarEmpresa.sql</strong> para poder salvar.
    </div>
}

<form method="post" enctype="multipart/form-data">
    <div class="card">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-building me-2"></i>Empresa</h6>
            <input type="hidden" asp-for="DsLogo" id="cfgDsLogo" />
            <div class="row g-4">
                <div class="col-lg-7">
                    <label class="form-label">Nome da empresa *</label>
                    <input type="text" class="form-control" asp-for="NmEmpresa" id="cfgNome" maxlength="100" required
                           placeholder="Ex: R10 Barber Shop" />
                    <small class="text-muted d-block">Aparece no topo do menu lateral e no título das páginas.</small>

                    <label class="form-label mt-3">Logo</label>
                    <input type="file" class="form-control" asp-for="LogoUpload" id="cfgLogo" accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <small class="text-muted d-block">Formatos: JPG, PNG, WEBP, GIF (máx. 5 MB). De preferência quadrada, pois aparece num círculo.</small>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" id="cfgRemoverLogo">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Voltar para a logo padrão
                        </button>
                    </div>
                </div>
                <div class="col-lg-5">
                    <label class="form-label">Pré-visualização do menu</label>
                    @* Mesmo visual do topo do menu lateral (classes do _Layout) *@
                    <div class="cfg-preview">
                        <img src="@logoAtual" alt="Logo" class="sidebar-logo" id="cfgPreviewLogo" />
                        <span class="sidebar-brand" id="cfgPreviewNome">@Model.NmEmpresa</span>
                    </div>
                </div>
            </div>
            @if (Model.Empresa != null)
            {
                <partial name="_Registro" model="Model.Empresa" />
            }
        </div>
        <div class="card-footer bg-white d-flex justify-content-end">
            <button type="submit" class="btn btn-primary" disabled="@(!Model.TabelaCriada)">
                <i class="bi bi-check-lg me-1"></i>Salvar configurações
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script type="application/json" id="dadosTela">
    {
        "LOGO_PADRAO": @Json.Serialize(logoPadrao)
    }
    </script>
    <script src="~/Pages/Seguranca/Configuracoes.cshtml.js" asp-append-version="true"></script>
}
