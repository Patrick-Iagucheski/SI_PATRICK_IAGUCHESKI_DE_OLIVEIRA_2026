@page
@model WebAppERP.Pages.Operacional.VeiculosModel
@{
    ViewData["Title"] = "Veículos";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Veículos</h1>
        <p class="page-subtitle">Gerencie os veículos cadastrados no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalVeiculo" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Novo Veículo
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Placa / ANTT</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-truck-flatbed me-2"></i>Lista de Veículos</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Veiculos.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblVeiculos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Placa</th>
                    <th>Estado</th>
                    <th>UF</th>
                    <th>ANTT</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Veiculos.Any())
                {
                    @foreach (var v in Model.Veiculos)
                    {
                        <tr>
                            <td>@v.IdVeiculo</td>
                            <td><strong>@v.DsPlaca</strong></td>
                            <td>@(v.Estado?.NmEstado ?? "-")</td>
                            <td>@(v.Estado?.SgUF ?? "-")</td>
                            <td>@(v.NrANTT ?? "-")</td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalVeiculo"
                                        onclick="editarVeiculo(@v.IdVeiculo, '@v.DsPlaca','@(v.IdEstado?.ToString() ?? "")','@v.NrANTT')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este veiculo?')">
                                    <input type="hidden" name="id" value="@v.IdVeiculo" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Nenhum veículo cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar Veiculo -->
<div class="modal fade" id="modalVeiculo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-truck-flatbed me-2"></i>Novo Veículo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="VeiculoForm.IdVeiculo" id="formIdVeiculo" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Placa *</label>
                            <input type="text" class="form-control text-uppercase" asp-for="VeiculoForm.DsPlaca" id="formDsPlaca" maxlength="8" placeholder="ABC1D23" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ANTT</label>
                            <input type="text" class="form-control" asp-for="VeiculoForm.NrANTT" id="formNrANTT" maxlength="20" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Estado (UF de emplacamento)</label>
                            <select class="form-select" asp-for="VeiculoForm.IdEstado" id="formIdEstado">
                                <option value="">Selecione o estado</option>
                                @foreach (var estado in Model.Estados)
                                {
                                    <option value="@estado.IdEstado">@estado.NmEstado / @estado.SgUF</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Pages/Operacional/Veiculos.cshtml.js" asp-append-version="true"></script>
}
