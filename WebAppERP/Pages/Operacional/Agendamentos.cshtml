@page
@model WebAppERP.Pages.Operacional.AgendamentosModel
@{
    ViewData["Title"] = "Agendamentos";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Agendamentos</h1>
        <p class="page-subtitle">Gerencie a agenda da barbearia</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAgendamento" onclick="limparFormAgendamento()">
        <i class="bi bi-plus-lg me-1"></i> Novo Agendamento
    </button>
</div>

<!-- KPI Resumo -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card kpi-card kpi-blue">
            <div class="card-body d-flex align-items-center justify-content-between py-3">
                <div>
                    <div class="kpi-label">Agendados</div>
                    <div class="kpi-value mt-1" style="font-size:1.4rem;">@Model.QtdAgendados</div>
                </div>
                <i class="bi bi-calendar-event text-primary fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card kpi-purple">
            <div class="card-body d-flex align-items-center justify-content-between py-3">
                <div>
                    <div class="kpi-label">Confirmados</div>
                    <div class="kpi-value mt-1" style="font-size:1.4rem;">@Model.QtdConfirmados</div>
                </div>
                <i class="bi bi-calendar-check fs-3" style="color:#8b5cf6;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card kpi-orange">
            <div class="card-body d-flex align-items-center justify-content-between py-3">
                <div>
                    <div class="kpi-label">Em Atendimento</div>
                    <div class="kpi-value mt-1" style="font-size:1.4rem;">@Model.QtdEmAtendimento</div>
                </div>
                <i class="bi bi-hourglass-split fs-3" style="color:#f59e0b;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card kpi-green">
            <div class="card-body d-flex align-items-center justify-content-between py-3">
                <div>
                    <div class="kpi-label">Concluídos</div>
                    <div class="kpi-value mt-1" style="font-size:1.4rem;">@Model.QtdConcluidos</div>
                </div>
                <i class="bi bi-check-circle text-success fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Filtros de busca. A data busca a agenda do dia no servidor; os demais filtram a lista carregada -->
<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" id="formFiltro">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-1">Data</label>
                    <input type="date" class="form-control" name="DataFiltro" id="buscaData" value="@Model.DataFiltro" data-carregada="@Model.DataFiltro" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">Cliente / Serviço / Profissional</label>
                    <input type="text" class="form-control" id="buscaTexto" autocomplete="off" name="texto" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Situação</label>
                    <select class="form-select" name="situacao" id="buscaSituacao">
                        <option value="">Todas</option>
                        <option value="@Agendamento.AGENDADO">Agendado</option>
                        <option value="@Agendamento.CONFIRMADO">Confirmado</option>
                        <option value="@Agendamento.EM_ATENDIMENTO">Em atendimento</option>
                        <option value="@Agendamento.CONCLUIDO">Concluído</option>
                        <option value="@Agendamento.CANCELADO">Cancelado</option>
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div></div>
                <button type="button" class="btn btn-primary" onclick="buscarAgenda()">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-calendar-check-fill me-2"></i>Agenda do Dia - @(DateOnly.TryParse(Model.DataFiltro, out var dt) ? dt.ToString("dd/MM/yyyy") : "")</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Agendamentos.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblAgendamentos">
            <thead>
                <tr>
                    <th>Horário</th>
                    <th>Cliente</th>
                    <th>Serviço</th>
                    <th>Profissional</th>
                    <th>Duração</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Agendamentos.Any())
                {
                    @foreach (var a in Model.Agendamentos)
                    {
                        var badgeClass = a.TpStatus switch
                        {
                            Agendamento.AGENDADO => "badge-agendado",
                            Agendamento.CONFIRMADO => "badge-confirmado",
                            Agendamento.EM_ATENDIMENTO => "badge-em-atendimento",
                            Agendamento.CONCLUIDO => "badge-concluido",
                            Agendamento.CANCELADO => "badge-cancelado",
                            _ => "badge-agendado"
                        };
                        var isCancelado = a.TpStatus == Agendamento.CANCELADO;
                        <tr data-status="@a.TpStatus" class="@(isCancelado ? "table-light text-decoration-line-through" : "")">
                            <td><strong>@a.HrInicio.ToString("HH:mm")@(a.HrFim.HasValue ? $" - {a.HrFim.Value:HH:mm}" : "")</strong></td>
                            <td>@a.Cliente?.NmCliente</td>
                            <td>@a.Servico?.DsServico</td>
                            <td>@a.Funcionario?.NmFuncionario</td>
                            <td>@(a.Servico?.NrDuracaoMin.HasValue == true ? $"{a.Servico.NrDuracaoMin} min" : "-")</td>
                            <td>R$ @(a.Servico?.VlServico.ToString("N2") ?? "0,00")</td>
                            <td><span class="badge-status @badgeClass">@a.TpStatus.Replace("_", " ")</span></td>
                            <td class="text-center">
                                @if (a.TpStatus == Agendamento.AGENDADO)
                                {
                                    <form method="post" asp-page-handler="AlterarSituacao" class="d-inline">
                                        <input type="hidden" name="id" value="@a.IdAgendamento" />
                                        <input type="hidden" name="status" value="@Agendamento.CONFIRMADO" />
                                        <input type="hidden" name="data" value="@Model.DataFiltro" />
                                        <button type="submit" class="btn btn-icon btn-outline-info" title="Confirmar"><i class="bi bi-check2"></i></button>
                                    </form>
                                }
                                @if (a.TpStatus == Agendamento.CONFIRMADO)
                                {
                                    <form method="post" asp-page-handler="AlterarSituacao" class="d-inline">
                                        <input type="hidden" name="id" value="@a.IdAgendamento" />
                                        <input type="hidden" name="status" value="@Agendamento.EM_ATENDIMENTO" />
                                        <input type="hidden" name="data" value="@Model.DataFiltro" />
                                        <button type="submit" class="btn btn-icon btn-outline-warning" title="Iniciar"><i class="bi bi-play-fill"></i></button>
                                    </form>
                                }
                                @if (a.TpStatus == Agendamento.EM_ATENDIMENTO)
                                {
                                    <form method="post" asp-page-handler="AlterarSituacao" class="d-inline">
                                        <input type="hidden" name="id" value="@a.IdAgendamento" />
                                        <input type="hidden" name="status" value="@Agendamento.CONCLUIDO" />
                                        <input type="hidden" name="data" value="@Model.DataFiltro" />
                                        <button type="submit" class="btn btn-icon btn-outline-success" title="Concluir"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }
                                @if (a.TpStatus != Agendamento.CONCLUIDO && a.TpStatus != Agendamento.CANCELADO)
                                {
                                    <form method="post" asp-page-handler="AlterarSituacao" class="d-inline" onsubmit="return confirm('Cancelar este agendamento?')">
                                        <input type="hidden" name="id" value="@a.IdAgendamento" />
                                        <input type="hidden" name="status" value="@Agendamento.CANCELADO" />
                                        <input type="hidden" name="data" value="@Model.DataFiltro" />
                                        <button type="submit" class="btn btn-icon btn-outline-danger" title="Cancelar"><i class="bi bi-x-lg"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Nenhum agendamento para esta data</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar Agendamento (componente compartilhado com a Venda) -->
@await Component.InvokeAsync("CadastroAgendamento", new { modo = "post", data = Model.DataFiltro })

<!-- Cadastros compartilhados, abertos pelo Novo/Editar das pesquisas de cliente,
     profissional e servico. Gravam por AJAX e voltam para a pesquisa. -->
@await Component.InvokeAsync("CadastroCliente", new { modo = "ajax" })
@await Component.InvokeAsync("CadastroFuncionario", new { modo = "ajax" })
@await Component.InvokeAsync("CadastroServico", new { modo = "ajax" })

@section Scripts {
    @* Os scripts dos cadastros vem com os proprios componentes. *@
    <script src="~/Pages/Operacional/Agendamentos.cshtml.js" asp-append-version="true"></script>
}
