@page
@model WebAppERP.Pages.Gerais.FuncionariosModel
@using System.Globalization
@{
    ViewData["Title"] = "Funcionários";
    // Valores passados ao JavaScript vao com ponto decimal (o campo numerico nao aceita virgula).
    CultureInfo inv = CultureInfo.InvariantCulture;

}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Funcionários</h1>
        <p class="page-subtitle">Gerencie os profissionais da barbearia</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalFuncionario" onclick="limparFormFuncionario()">
        <i class="bi bi-plus-lg me-1"></i> Novo Funcionário
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Funcionário</label>
                <input type="text" class="form-control" id="buscaNome" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Apelido</label>
                <input type="text" class="form-control" id="buscaApelido" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">CPF</label>
                <input type="text" class="form-control" id="buscaCpf" maxlength="14" placeholder="000.000.000-00" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="buscaInativos" onchange="buscarFuncionarios()" />
                <label class="form-check-label" for="buscaInativos">Exibir Funcionários Inativos</label>
            </div>
            <button type="button" class="btn btn-primary" onclick="buscarFuncionarios()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-person-badge-fill me-2"></i>Lista de Funcionários</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Funcionarios.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblFuncionarios">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Funcionário</th>
                    <th>CPF</th>
                    <th>Cargo</th>
                    <th>Telefone</th>
                    <th>Admissão</th>
                    <th>Comissão</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Funcionarios.Any())
                {
                    @foreach (var f in Model.Funcionarios)
                    {
                        <tr>
                            <td>@f.IdFuncionario</td>
                            <td><strong>@f.NmFuncionario</strong></td>
                            <td>@Module.OuTraco(Module.FormatarCpf(f.NrCpf))</td>
                            <td>@(f.Cargo?.NmCargo ?? "-")</td>
                            <td>@Module.OuTraco(Module.FormatarTelefone(f.NrTelefone))</td>
                            <td>@f.DtAdmissao.ToString("dd/MM/yyyy")</td>
                            <td>@(f.VlComissao.HasValue ? $"{f.VlComissao}%" : "-")</td>
                            <td>
                                @if (f.FlAtivo)
                                {
                                    <span class="badge-status badge-ativo">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inativo">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalFuncionario"
                                        onclick="editarFunc(@f.IdFuncionario,'@f.NmFuncionario.Replace("'", "\\'")','@f.NrCpf','@f.NrTelefone','@f.DsEmail','@f.DsEndereco?.Replace("'", "\\'")','@f.DsBairro?.Replace("'", "\\'")','@(f.IdCidade?.ToString() ?? "")','@f.NrCEP','@(f.DtNascimento?.ToString("yyyy-MM-dd") ?? "")','@f.DtAdmissao.ToString("yyyy-MM-dd")','@(f.DtDemissao?.ToString("yyyy-MM-dd") ?? "")','@f.IdCargo','@(f.VlSalario?.ToString("F2", inv) ?? "")','@(f.VlComissao?.ToString("F2", inv) ?? "")','@f.DsObservacao?.Replace("'", "\\'")','@f.FlAtivo','@f.NmApelido?.Replace("'", "\\'")','@f.NrRG','@f.NrNumero','@f.DsComplemento?.Replace("'", "\\'")','@f.DsSexo')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este funcionário?')">
                                    <input type="hidden" name="id" value="@f.IdFuncionario" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Nenhum funcionário cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar (Funcionario): componente compartilhado -->
@await Component.InvokeAsync("CadastroFuncionario", new { modo = "post" })

@section Scripts {
    <script src="~/Pages/Gerais/Funcionarios.cshtml.js" asp-append-version="true"></script>
}
