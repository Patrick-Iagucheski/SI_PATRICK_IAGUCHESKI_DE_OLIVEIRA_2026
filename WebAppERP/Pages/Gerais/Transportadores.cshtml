@page
@model WebAppERP.Pages.Gerais.TransportadoresModel
@{
    ViewData["Title"] = "Transportadores";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Transportadores</h1>
        <p class="page-subtitle">Gerencie os transportadores cadastrados no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTransportador" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Novo Transportador
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Razão Social / CPF / CNPJ</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-truck-front me-2"></i>Lista de Transportadores</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Transportadores.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblTransportadores">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Razão Social</th>
                    <th>CPF/CNPJ</th>
                    <th>Endereço</th>
                    <th>Cidade</th>
                    <th>Insc. Estadual</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transportadores.Any())
                {
                    @foreach (var t in Model.Transportadores)
                    {
                        <tr>
                            <td>@t.IdTransportador</td>
                            <td><strong>@(t.DsRazaoSocial ?? "-")</strong></td>
                            <td>@(t.NrCpfCnpj ?? "-")</td>
                            <td>@(t.DsEndereco ?? "-")</td>
                            <td>@(t.Cidade != null ? $"{t.Cidade.NmCidade}/{t.Cidade.Estado?.SgUF}" : "-")</td>
                            <td>@(t.NrInscEstadual ?? "-")</td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalTransportador"
                                        onclick="editarTransportador(@t.IdTransportador, '@t.DsRazaoSocial?.Replace("'", "\\'")','@t.NrCpfCnpj','@t.DsEndereco?.Replace("'", "\\'")','@(t.IdCidade?.ToString() ?? "")','@t.NrInscEstadual')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este transportador?')">
                                    <input type="hidden" name="id" value="@t.IdTransportador" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhum transportador cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar Transportador -->
<div class="modal fade" id="modalTransportador" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" data-modal-ajax>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-truck-front me-2"></i>Novo Transportador</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="TransportadorForm.IdTransportador" id="formIdTransportador" />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Razão Social *</label>
                            <input type="text" class="form-control" asp-for="TransportadorForm.DsRazaoSocial" id="formDsRazaoSocial" maxlength="200" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">CPF / CNPJ *</label>
                            <input type="text" class="form-control" asp-for="TransportadorForm.NrCpfCnpj" id="formNrCpfCnpj" maxlength="18" placeholder="000.000.000-00" required />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Endereço</label>
                            <input type="text" class="form-control" asp-for="TransportadorForm.DsEndereco" id="formDsEndereco" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Cidade</label>
                            @await Component.InvokeAsync("CampoCidade", new { nome = "TransportadorForm.IdCidade", id = "formIdCidade", idCidade = Model.TransportadorForm.IdCidade })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Inscrição Estadual</label>
                            <input type="text" class="form-control" asp-for="TransportadorForm.NrInscEstadual" id="formNrInscEstadual" maxlength="20" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Pages/Gerais/Transportadores.cshtml.js" asp-append-version="true"></script>
}
