@page
@model WebAppERP.Pages.Gerais.ServicosModel
@using System.Globalization
@{
    ViewData["Title"] = "Serviços";
    // Valores passados ao JavaScript vao com ponto decimal (o campo numerico nao aceita virgula).
    CultureInfo inv = CultureInfo.InvariantCulture;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Serviços</h1>
        <p class="page-subtitle">Gerencie os serviços oferecidos pela barbearia</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalServico" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Novo Serviço
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Serviço / Categoria</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="buscaInativos" />
                <label class="form-check-label" for="buscaInativos">Exibir Serviços Inativos</label>
            </div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-card-checklist me-2"></i>Lista de Serviços</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Servicos.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblServicos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Serviço</th>
                    <th>Categoria</th>
                    <th class="text-end">Valor</th>
                    <th>Duração</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Servicos.Any())
                {
                    @foreach (var s in Model.Servicos)
                    {
                        <tr data-id="@s.IdServico" data-status="@(s.FlAtivo ? "ativo" : "inativo")">
                            <td>@s.IdServico</td>
                            <td>
                                <strong>@s.DsServico</strong>
                                @if (!string.IsNullOrEmpty(s.DsDescricao))
                                {
                                    <div class="text-muted small">@s.DsDescricao</div>
                                }
                            </td>
                            <td>@(s.DsCategoria ?? "-")</td>
                            <td class="text-end"><strong>R$ @s.VlServico.ToString("N2")</strong></td>
                            <td>@(s.NrDuracaoMin.HasValue ? $"{s.NrDuracaoMin} min" : "-")</td>
                            <td>
                                @if (s.FlAtivo)
                                {
                                    <span class="badge-status badge-ativo">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inativo">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalServico"
                                        onclick="editarServico(@s.IdServico,'@s.DsServico.Replace("'", "\\'")','@s.DsDescricao?.Replace("'", "\\'")','@s.VlServico.ToString("F2", inv)','@(s.NrDuracaoMin?.ToString() ?? "")','@s.DsCategoria','@s.FlAtivo')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este serviço?')">
                                    <input type="hidden" name="id" value="@s.IdServico" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhum serviço cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalServico" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-card-checklist me-2"></i>Novo Serviço</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="ServicoForm.IdServico" id="sId" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nome do Serviço *</label>
                            <input type="text" class="form-control" asp-for="ServicoForm.DsServico" id="sNome" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descrição</label>
                            <textarea class="form-control" rows="2" asp-for="ServicoForm.DsDescricao" id="sDesc"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Valor (R$) *</label>
                            <input type="number" class="form-control" asp-for="ServicoForm.VlServico" id="sValor" step="0.01" min="0.01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Duração (min)</label>
                            <input type="number" class="form-control" asp-for="ServicoForm.NrDuracaoMin" id="sDuracao" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoria</label>
                            <select class="form-select" asp-for="ServicoForm.DsCategoria" id="sCat">
                                <option value="">Selecione</option>
                                <option value="Corte">Corte</option>
                                <option value="Barba">Barba</option>
                                <option value="Combo">Combo</option>
                                <option value="Tratamento">Tratamento</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select class="form-select" asp-for="ServicoForm.FlAtivo" id="sAtivo">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Pages/Gerais/Servicos.cshtml.js" asp-append-version="true"></script>
}
