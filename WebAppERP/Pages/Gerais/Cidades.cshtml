@page
@model WebAppERP.Pages.Gerais.CidadesModel
@{
    ViewData["Title"] = "Cidades";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Cidades</h1>
        <p class="page-subtitle">Gerencie as cidades cadastradas no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCidade" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Nova Cidade
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Nome da Cidade</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Estado</label>
                <select class="form-select" id="buscaEstado">
                    <option value="">Todos os Estados</option>
                    @foreach (var estado in Model.Estados)
                    {
                        <option value="@estado.SgUF">@estado.NmEstado</option>
                    }
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-building me-2"></i>Lista de Cidades</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Cidades.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblCidades">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Estado</th>
                    <th>UF</th>
                    <th>Última Edição</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Cidades.Any())
                {
                    @foreach (var c in Model.Cidades)
                    {
                        <tr data-uf="@c.Estado?.SgUF">
                            <td>@c.IdCidade</td>
                            <td><strong>@c.NmCidade</strong></td>
                            <td>@(c.Estado?.NmEstado ?? "-")</td>
                            <td>@(c.Estado?.SgUF ?? "-")</td>
                            <td>@(c.DtEdicao?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalCidade"
                                        data-registro="@Module.RegistroJson(c)"
                                        onclick="editarCidade(@c.IdCidade, '@c.NmCidade.Replace("'", "\\'")','@c.IdEstado')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir esta cidade?')">
                                    <input type="hidden" name="id" value="@c.IdCidade" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma cidade cadastrada</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nova/Editar Cidade -->
<div class="modal fade" id="modalCidade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-building me-2"></i>Nova Cidade</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="CidadeForm.IdCidade" id="formIdCidade" />
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">Código</label>
                            <input type="text" class="form-control bg-light" id="formCodigoDisplay" placeholder="(novo)" readonly />
                        </div>
                        <div class="col-md-10">
                            <label class="form-label">Nome da Cidade *</label>
                            <input type="text" class="form-control" asp-for="CidadeForm.NmCidade" id="formNmCidade" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Estado *</label>
                            <select class="form-select" asp-for="CidadeForm.IdEstado" id="formIdEstado" required
                                    data-pesquisa="abrirPesquisaEstado('formIdEstado')" data-titulo-pesquisa="Pesquisar estado">
                                <option value="">Selecione o estado</option>
                                @foreach (var estado in Model.Estados)
                                {
                                    <option value="@estado.IdEstado">@estado.NmEstado / @estado.SgUF</option>
                                }
                            </select>
                        </div>
                    </div>
                    <partial name="_Registro" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Pesquisas e cadastros de estado / pais (lupa do campo), do componente de cidade -->
@await Component.InvokeAsync("CampoCidade", new { somenteCadastros = true })

@section Scripts {
    <script src="~/Pages/Gerais/Cidades.cshtml.js" asp-append-version="true"></script>
}
