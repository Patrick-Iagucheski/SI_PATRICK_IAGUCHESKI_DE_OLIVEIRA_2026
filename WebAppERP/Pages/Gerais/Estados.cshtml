@page
@model WebAppERP.Pages.Gerais.EstadosModel
@{
    ViewData["Title"] = "Estados";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Estados</h1>
        <p class="page-subtitle">Gerencie os estados / UFs cadastrados no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalEstado" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Novo Estado
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Nome / UF</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-map me-2"></i>Lista de Estados</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Estados.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblEstados">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>UF</th>
                    <th>Nome</th>
                    <th>País</th>
                    <th>Última Edição</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Estados.Any())
                {
                    @foreach (var e in Model.Estados)
                    {
                        <tr>
                            <td>@e.IdEstado</td>
                            <td><strong>@e.SgUF</strong></td>
                            <td>@e.NmEstado</td>
                            <td>@(e.Pais?.NmPais ?? "-")</td>
                            <td>@(e.DtEdicao?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalEstado"
                                        data-registro="@Module.RegistroJson(e)"
                                        onclick="editarEstado(@e.IdEstado, '@e.SgUF','@e.NmEstado.Replace("'", "\\'")','@e.IdPais')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este estado?')">
                                    <input type="hidden" name="id" value="@e.IdEstado" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Nenhum estado cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar Estado -->
<div class="modal fade" id="modalEstado" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-map me-2"></i>Novo Estado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EstadoForm.IdEstado" id="formIdEstado" />
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">Código</label>
                            <input type="text" class="form-control bg-light" id="formCodigoDisplay" placeholder="(novo)" readonly />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">UF *</label>
                            <input type="text" class="form-control text-uppercase" asp-for="EstadoForm.SgUF" id="formSgUF" maxlength="2" placeholder="SP" required pattern="[A-Za-z]{2}" title="2 letras, sem acento. Exemplo: PR" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Nome do Estado *</label>
                            <input maxlength="60" type="text" class="form-control" asp-for="EstadoForm.NmEstado" id="formNmEstado" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">País *</label>
                            <select class="form-select" asp-for="EstadoForm.IdPais" id="formIdPais" required
                                    data-pesquisa="abrirPesquisaPais('formIdPais')" data-titulo-pesquisa="Pesquisar país">
                                <option value="">Selecione o país</option>
                                @foreach (var pais in Model.Paises)
                                {
                                    <option value="@pais.IdPais">@pais.NmPais</option>
                                }
                            </select>
                        </div>
                    </div>
                    <partial name="_Registro" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Pesquisas e cadastros de estado / pais (lupa do campo), do componente de cidade -->
@await Component.InvokeAsync("CampoCidade", new { somenteCadastros = true })

@section Scripts {
    <script src="~/Pages/Gerais/Estados.cshtml.js" asp-append-version="true"></script>
}
