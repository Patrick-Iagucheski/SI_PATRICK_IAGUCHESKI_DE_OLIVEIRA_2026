@page
@model WebAppERP.Pages.Vendas.VendasModel
@{
    ViewData["Title"] = "Vendas";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Vendas</h1>
        <p class="page-subtitle">Gerencie as vendas realizadas no sistema</p>
    </div>
    <a class="btn btn-primary" asp-page="/Vendas/Venda">
        <i class="bi bi-plus-lg me-1"></i> Nova Venda
    </a>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">Nº da Venda</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Cliente / Funcionário</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Situação</label>
                <select class="form-select" id="buscaSituacao">
                    <option value="">Todas</option>
                    <option value="@Venda.ABERTA">Aberta</option>
                    <option value="@Venda.FINALIZADA">Finalizada</option>
                    <option value="@Venda.CANCELADA">Cancelada</option>
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-cart-check me-2"></i>Lista de Vendas</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Vendas.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblVendas">
            <thead>
                <tr>
                    <th>Venda</th>
                    <th>Data</th>
                    <th>Cliente</th>
                    <th>Funcionário</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Vendas.Any())
                {
                    @foreach (var v in Model.Vendas)
                    {
                        var badge = v.TpStatus switch
                        {
                            Venda.FINALIZADA => "badge-concluido",
                            Venda.CANCELADA => "badge-cancelado",
                            _ => "badge-agendado"
                        };
                        <tr data-id="@v.IdVenda" data-status="@v.TpStatus">
                            <td><strong>#@v.IdVenda</strong></td>
                            <td>@v.DtVenda.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(v.Cliente?.NmCliente ?? "Consumidor")</td>
                            <td>@(v.Funcionario?.NmFuncionario ?? "-")</td>
                            <td class="text-end"><strong>R$ @v.VlTotal.ToString("N2")</strong></td>
                            <td><span class="badge-status @badge">@v.TpStatus</span></td>
                            <td class="text-center" style="white-space: nowrap;">
                                @* So a venda aberta e editada; finalizada e cancelada abrem para ver *@
                                <a class="btn btn-icon btn-outline-primary" title="@(v.TpStatus == Venda.ABERTA ? "Editar" : "Visualizar")" asp-page="/Vendas/Venda" asp-route-id="@v.IdVenda">
                                    <i class="bi @(v.TpStatus == Venda.ABERTA ? "bi-pencil" : "bi-eye")"></i>
                                </a>
                                @if (v.TpStatus != Venda.CANCELADA)
                                {
                                    <form method="post" asp-page-handler="Cancelar" class="d-inline" onsubmit="return confirm('Deseja cancelar esta venda? Se estiver finalizada, o estoque será estornado e os títulos do Contas a Receber serão cancelados.')">
                                        <input type="hidden" name="id" value="@v.IdVenda" />
                                        <button type="submit" class="btn btn-icon btn-outline-warning" title="Cancelar venda">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma venda registrada</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/Pages/Vendas/Vendas.cshtml.js" asp-append-version="true"></script>
}
