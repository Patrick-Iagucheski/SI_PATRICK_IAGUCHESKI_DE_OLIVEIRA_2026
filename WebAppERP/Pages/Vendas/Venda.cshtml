@page
@model WebAppERP.Pages.Vendas.VendaModel
@{
    // Tela de digitacao: a aba nao recarrega sozinha ao voltar (site.js)
    ViewData["ManterAoVoltar"] = true;
    ViewData["Title"] = Model.Vm.Venda.IdVenda > 0 ? $"Venda #{Model.Vm.Venda.IdVenda}" : "Nova Venda";
    var ro = Model.Vm.SomenteLeitura;
    var salvarSozinho = !ro && Model.Vm.Venda.TpStatus == Venda.ABERTA;
    var disabledAttr = ro ? "disabled" : null;
    var statusBadge = Model.Vm.Venda.TpStatus switch
    {
        Venda.FINALIZADA => "badge-concluido",
        Venda.CANCELADA => "badge-cancelado",
        _ => "badge-agendado"
    };

    var produtosJs = WebAppERP.Pages.Vendas.VendaModel.ProdutosDaTela(Model.Vm.Combos.Produtos);
    var servicosJs = WebAppERP.Pages.Vendas.VendaModel.ServicosDaTela(Model.Vm.Combos.Servicos);
    var itensJs = Model.Vm.Itens.Select(i => new
    {
        tpItem = i.TpItem,
        idServico = i.IdServico,
        idProduto = i.IdProduto,
        descricao = i.TpItem == VendaItem.PRODUTO ? (i.Produto != null ? i.Produto.DsProduto : "") : (i.Servico != null ? i.Servico.DsServico : ""),
        qtItem = i.QtItem,
        vlUnitario = i.VlUnitario,
        vlDesconto = i.VlDesconto,
        vlTotal = i.VlTotal
    });
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">
            <span id="tituloVenda">@(Model.Vm.Venda.IdVenda > 0 ? $"Venda #{Model.Vm.Venda.IdVenda}" : "Nova Venda")</span>
            <span class="badge-status @statusBadge ms-2">@Model.Vm.Venda.TpStatus</span>
        </h1>
        <p class="page-subtitle">Cabecalho, itens e totais da venda</p>
    </div>
    <div class="d-flex gap-2">
        <span class="small text-muted align-self-center" id="autoSalvarStatus"></span>
        @if (!ro)
        {
            <button type="button" class="btn btn-outline-primary" id="btnAtualizar" onclick="atualizarDados()"
                    title="Busca de novo clientes, funcionários, agendamentos, formas, condições, produtos e serviços. Em venda aberta, também atualiza os preços dos itens e a condição do cliente.">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </button>
        }
        <a class="btn btn-secondary" asp-page="/Vendas/Vendas">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.Erro</div>
}
@if (Model.Vm.MensagemSomenteLeitura is { } aviso)
{
    <div class="alert alert-warning"><i class="bi bi-lock me-2"></i>@aviso</div>
}

<form method="post" id="formVenda">
    <input type="hidden" asp-for="IdVenda" />
    <input type="hidden" asp-for="TpStatus" id="TpStatus" />
    <input type="hidden" asp-for="ItensJson" id="ItensJson" />

    <!-- Cabecalho da Venda -->
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-receipt me-2"></i>Dados da Venda</h6>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Número</label>
                    <input type="text" class="form-control" id="vendaNumero" value="@(Model.Vm.Venda.IdVenda > 0 ? "#" + Model.Vm.Venda.IdVenda : "Novo")" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data da Venda</label>
                    <input type="text" class="form-control" value="@Model.Vm.Venda.DtVenda.ToString("dd/MM/yyyy HH:mm")" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cliente</label>
                    <select class="form-select" asp-for="IdCliente" id="IdCliente" disabled="@ro"
                            data-pesquisa="abrirPesquisaCliente(opcoesDoSelect('IdCliente'))" data-titulo-pesquisa="Pesquisar cliente">
                        <option value="">Consumidor (sem cadastro)</option>
                        @foreach (var c in Model.Vm.Combos.Clientes)
                        {
                            <option value="@c.IdCliente" data-detalhe="@Module.DocumentoPessoa(c)">@c.NmCliente</option>
                        }
                        @* Cliente da venda inativado depois: continua no campo *@
                        @if (Model.Vm.Venda.Cliente is { FlAtivo: false } clienteInativo)
                        {
                            <option value="@clienteInativo.IdCliente" data-detalhe="@Module.DocumentoPessoa(clienteInativo)">@clienteInativo.NmCliente (inativo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Funcionário *</label>
                    <select class="form-select" asp-for="IdFuncionario" id="IdFuncionario" required disabled="@ro"
                            data-pesquisa="abrirPesquisaFuncionario(opcoesDoSelect('IdFuncionario'))" data-titulo-pesquisa="Pesquisar funcionário">
                        <option value="">Selecione</option>
                        @foreach (var f in Model.Vm.Combos.Funcionarios)
                        {
                            <option value="@f.IdFuncionario">@f.NmFuncionario</option>
                        }
                        @if (Model.Vm.Venda.Funcionario is { FlAtivo: false } funcionarioInativo)
                        {
                            <option value="@funcionarioInativo.IdFuncionario">@funcionarioInativo.NmFuncionario (inativo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Agendamento (opcional)</label>
                    @* Campo de selecao: a pesquisa (componente CadastroAgendamento) seleciona, edita e cadastra *@
                    <select class="form-select" asp-for="IdAgendamento" id="IdAgendamento" disabled="@ro"
                            data-pesquisa="abrirPesquisaAgendamento(opcoesDoSelect('IdAgendamento'))" data-titulo-pesquisa="Pesquisar agendamento">
                        <option value="">Nenhum</option>
                        @foreach (var a in Model.Vm.Combos.Agendamentos)
                        {
                            <option value="@a.IdAgendamento">@WebAppERP.Pages.Vendas.VendaModel.TextoAgendamento(a)</option>
                        }
                        @* Agendamento da venda fora da lista (outro dia ou cancelado depois): continua no campo *@
                        @if (Model.Vm.Agendamento is { } agendamentoVenda
                             && !Model.Vm.Combos.Agendamentos.Any(a => a.IdAgendamento == agendamentoVenda.IdAgendamento))
                        {
                            <option value="@agendamentoVenda.IdAgendamento">@WebAppERP.Pages.Vendas.VendaModel.TextoAgendamento(agendamentoVenda)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Forma de Pagamento</label>
                    <select class="form-select" asp-for="IdFormaPagamento" id="IdFormaPagamento" disabled="@ro"
                            data-pesquisa="abrirPesquisaForma(opcoesDoSelect('IdFormaPagamento'))" data-titulo-pesquisa="Pesquisar forma de pagamento">
                        <option value="">Selecione</option>
                        @foreach (var fp in Model.Vm.Combos.Formas)
                        {
                            <option value="@fp.IdFormaPagamento">@fp.DsFormaPagamento</option>
                        }
                        @* Forma da venda inativada depois: continua no campo *@
                        @if (Model.Vm.Venda.FormaPagamento is { FlAtivo: false } formaInativa)
                        {
                            <option value="@formaInativa.IdFormaPagamento">@formaInativa.DsFormaPagamento (inativo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Condição de Pagamento</label>
                    @* Com condicao, a forma vem das parcelas dela; sem condicao, a venda e a vista *@
                    <select class="form-select" asp-for="IdCondicaoPagamento" id="IdCondicaoPagamento" disabled="@ro"
                            data-pesquisa="abrirPesquisaCondicao(opcoesDoSelect('IdCondicaoPagamento'))" data-titulo-pesquisa="Pesquisar condição de pagamento">
                        <option value="">À vista (sem condição)</option>
                        @foreach (var cp in Model.Vm.Combos.Condicoes)
                        {
                            <option value="@cp.IdCondicaoPagamento">@cp.DsCondicao</option>
                        }
                        @if (Model.Vm.Venda.CondicaoPagamento is { FlAtivo: false } inativa)
                        {
                            <option value="@inativa.IdCondicaoPagamento">@inativa.DsCondicao (inativo)</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (!ro)
    {
        <!-- Adicionar Item -->
        <div class="card mb-3">
            <div class="card-body pb-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Adicionar Item</h6>
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="itTipo" onchange="onTipoChange()">
                            <option value="@VendaItem.PRODUTO">Produto</option>
                            <option value="@VendaItem.SERVICO">Serviço</option>
                        </select>
                    </div>
                    <!-- O saldo fica abaixo do campo sem ocupar altura (.dica-abaixo):
                         assim o campo nao sobe em relacao aos outros da linha. -->
                    <div class="col-md-4 position-relative" id="grpProduto">
                        <label class="form-label">Produto</label>
                        <select class="form-select" id="itProduto" onchange="onProdutoChange()"
                                data-pesquisa="abrirBuscaProdutoVenda()" data-titulo-pesquisa="Pesquisar produto">
                            <option value="">Selecione o produto</option>
                            @foreach (var p in Model.Vm.Combos.Produtos)
                            {
                                <option value="@p.IdProduto">@p.DsProduto</option>
                            }
                        </select>
                        <small class="dica-abaixo" id="itSaldo"></small>
                    </div>
                    <div class="col-md-4" id="grpServico" style="display:none;">
                        <label class="form-label">Serviço</label>
                        <select class="form-select" id="itServico" onchange="onServicoChange()"
                                data-pesquisa="abrirBuscaServicoVenda()" data-titulo-pesquisa="Pesquisar serviço">
                            <option value="">Selecione o serviço</option>
                            @foreach (var s in Model.Vm.Combos.Servicos)
                            {
                                <option value="@s.IdServico">@s.DsServico</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Qtd</label>
                        <input type="number" step="0.0001" class="form-control" id="itQt" value="1" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Vl. Unitario</label>
                        <input type="number" step="0.01" class="form-control" id="itVlUnit" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Desc.</label>
                        <input type="number" step="0.01" class="form-control" id="itDesc" value="0" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Total</label>
                        <input type="text" class="form-control" id="itTotal" readonly />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary w-100" id="btnAdicionarItem" onclick="adicionarItem()">
                            <i class="bi bi-plus-lg me-1"></i>Adicionar
                        </button>
                    </div>
                </div>
                <!-- Imagem do produto escolhido: so enquanto ele esta sendo lancado (some ao
                     adicionar). Produto sem imagem, ou com o arquivo ausente, nao mostra nada. -->
                <div class="mt-3 d-none" id="itImagemWrap">
                    <img id="itImagem" class="img-thumbnail" style="max-height: 140px;" alt="Imagem do produto" />
                </div>
            </div>
        </div>
    }

    <!-- Grid de Itens -->
    <div class="table-container mb-3">
        <div class="table-header">
            <h5><i class="bi bi-list-ul me-2"></i>Itens da Venda</h5>
        </div>
        <div class="table-responsive">
            <table class="table" id="tblItens">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Código</th>
                        <th>Descrição</th>
                        <th class="text-end">Qtd</th>
                        <th class="text-end">Vl. Unitario</th>
                        <th class="text-end">Desconto</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody id="itensBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Rodape: Observacao (sempre o ultimo campo) | Totais -->
    <div class="row g-3 justify-content-end">
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-body">
                    <label class="form-label">Observação</label>
                    <textarea class="form-control" rows="4" asp-for="DsObservacao" maxlength="500" disabled="@ro"></textarea>
                    @if (Model.Vm.Venda.IdVenda > 0)
                    {
                        <partial name="_Registro" model="Model.Vm.Venda" />
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold" id="lblSubtotal">R$ 0,00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Desconto Geral</span>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" style="max-width: 140px;" asp-for="VlDesconto" id="VlDesconto" disabled="@ro" />
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">Total Geral</span>
                        <span class="fw-bold fs-4 text-primary" id="lblTotal">R$ 0,00</span>
                    </div>
                    <div class="small text-danger text-end d-none" id="avisoDesconto">
                        O desconto passa do subtotal: a venda só pode ser finalizada quando os itens passarem do desconto.
                    </div>
                </div>
            </div>
            @if (!ro)
            {
                <div class="d-grid gap-2 mt-3">
                    <button type="button" class="btn btn-success btn-lg" onclick="salvar('FINALIZADA')">
                        <i class="bi bi-check2-circle me-1"></i>Finalizar Venda
                    </button>
                    <button type="button" class="btn btn-outline-primary" onclick="salvar('@Venda.ABERTA')">
                        <i class="bi bi-save me-1"></i>Salvar como Aberta
                    </button>
                </div>
            }
        </div>
    </div>
</form>

@if (!ro)
{
    <!-- Cadastros compartilhados, abertos pelo Novo/Editar das pesquisas de cliente,
         funcionario, produto, servico e forma de pagamento. Gravam por AJAX e voltam para a pesquisa. -->
    @await Component.InvokeAsync("CadastroCliente", new { modo = "ajax" })
    @await Component.InvokeAsync("CadastroFuncionario", new { modo = "ajax" })
    @await Component.InvokeAsync("CadastroProduto", new { modo = "ajax" })
    @await Component.InvokeAsync("CadastroServico", new { modo = "ajax" })
    @* Agendamento: Novo / Editar da pesquisa do campo (usa cliente, profissional e servico acima) *@
    @await Component.InvokeAsync("CadastroAgendamento", new { modo = "ajax" })
    @await Component.InvokeAsync("CadastroFormaPagamento", new { modo = "ajax" })
}

@section Scripts {
    @* Os scripts dos cadastros vem com os proprios componentes. *@
    <script type="application/json" id="dadosTela">
    {
        "TIPO_ITEM": { "PRODUTO": @Json.Serialize(VendaItem.PRODUTO), "SERVICO": @Json.Serialize(VendaItem.SERVICO) },
        "PRODUTOS": @Json.Serialize(produtosJs),
        "SERVICOS": @Json.Serialize(servicosJs),
        "SOMENTE_LEITURA": @Json.Serialize(Model.Vm.SomenteLeitura),
        "AUTO_SALVAR": @Json.Serialize(salvarSozinho),
        "ABERTA": @Json.Serialize(Venda.ABERTA),
        "ITENS": @Json.Serialize(itensJs)
    }
    </script>
    <script src="~/Pages/Vendas/Venda.cshtml.js" asp-append-version="true"></script>
}
