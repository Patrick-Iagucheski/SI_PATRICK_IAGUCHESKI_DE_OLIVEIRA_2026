@page
@model WebAppERP.Pages.Financeiro.FormasPagamentoModel
@{
    ViewData["Title"] = "Formas de Pagamento";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Formas de Pagamento</h1>
        <p class="page-subtitle">Gerencie as formas de pagamento aceitas no sistema</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalForma" onclick="limparForm()">
        <i class="bi bi-plus-lg me-1"></i> Nova Forma
    </button>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">ID</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Descrição</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="buscaInativos" />
                <label class="form-check-label" for="buscaInativos">Exibir Formas Inativas</label>
            </div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-credit-card me-2"></i>Lista de Formas de Pagamento</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Formas.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblFormas">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Descrição</th>
                    <th>Criado em</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Formas.Any())
                {
                    @foreach (var f in Model.Formas)
                    {
                        <tr data-status="@(f.FlAtivo ? "ativo" : "inativo")">
                            <td>@f.IdFormaPagamento</td>
                            <td><strong>@f.DsFormaPagamento</strong></td>
                            <td>@f.DtCriacao.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (f.FlAtivo)
                                {
                                    <span class="badge-status badge-ativo">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inativo">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="AlterarSituacao" class="d-inline">
                                    <input type="hidden" name="id" value="@f.IdFormaPagamento" />
                                    @if (f.FlAtivo)
                                    {
                                        <button type="submit" class="btn btn-icon btn-outline-warning" title="Inativar">
                                            <i class="bi bi-pause-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-icon btn-outline-success" title="Ativar">
                                            <i class="bi bi-play-circle"></i>
                                        </button>
                                    }
                                </form>
                                <button class="btn btn-icon btn-outline-primary" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalForma"
                                        onclick="editarForma(@f.IdFormaPagamento, '@f.DsFormaPagamento.Replace("'", "\\'")','@f.FlAtivo')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir esta forma de pagamento?')">
                                    <input type="hidden" name="id" value="@f.IdFormaPagamento" />
                                    <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma forma de pagamento cadastrada</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nova/Editar Forma -->
<div class="modal fade" id="modalForma" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" data-modal-ajax>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-credit-card me-2"></i>Nova Forma de Pagamento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="FormaForm.IdFormaPagamento" id="formIdForma" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Descrição *</label>
                            <input type="text" class="form-control" asp-for="FormaForm.DsFormaPagamento" id="formDsForma" maxlength="100" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Status</label>
                            <select class="form-select" asp-for="FormaForm.FlAtivo" id="formFlAtivo">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Pages/Financeiro/FormasPagamento.cshtml.js" asp-append-version="true"></script>
}
