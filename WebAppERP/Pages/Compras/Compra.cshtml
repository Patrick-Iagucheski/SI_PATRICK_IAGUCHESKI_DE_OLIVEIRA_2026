@page
@model WebAppERP.Pages.Compras.CompraModel
@{
    ViewData["Title"] = Model.Vm.Edicao
        ? $"Compra Nº {Model.Vm.Compra.NrNota}"
        : "Cadastro de Compras";

    var ro = Model.Vm.SomenteLeitura;

    // Chave validada libera o resto da tela; depois disso ela nao muda mais.
    var chaveOk = ro || Model.ChaveValidada;
    var chaveTravada = ro || Model.Vm.Edicao || Model.ChaveValidada;

    // Rascunho ja gravado: a tela salva sozinha a cada alteracao.
    var salvarSozinho = !ro && Model.Vm.Edicao && Model.Vm.Compra.TpStatus == Compra.RASCUNHO;
    var statusBadge = Model.Vm.Compra.TpStatus switch
    {
        Compra.FINALIZADA => "badge-concluido",
        Compra.CANCELADA => "badge-cancelado",
        _ => "badge-agendado"
    };

    var itensJs = Model.Vm.Itens.Select(i => new
    {
        tpItem = i.TpItem,
        idProduto = i.IdProduto,
        idServico = i.IdServico,
        codigo = i.TpItem == "PRODUTO" ? i.IdProduto : i.IdServico,
        descricao = i.TpItem == "PRODUTO" ? (i.Produto != null ? i.Produto.DsProduto : "") : (i.Servico != null ? i.Servico.DsServico : ""),
        idClassificacaoConta = i.IdClassificacaoConta,
        sgUnidade = i.SgUnidade,
        qtItem = i.QtItem,
        vlUnitario = i.VlUnitario,
        vlDesconto = i.VlDesconto,
        vlTotal = i.VlTotal
    });

    var pagamentosJs = Model.Vm.Pagamentos.Select(p => new
    {
        idCondicaoPagamento = p.IdCondicaoPagamento,
        condicaoNome = p.CondicaoPagamento != null ? p.CondicaoPagamento.DsCondicao : "-",
        idFormaPagamento = p.IdFormaPagamento,
        formaNome = p.FormaPagamento != null ? p.FormaPagamento.DsFormaPagamento : "-",
        vlParcela = p.VlParcela,
        dtVencimento = p.DtVencimento.ToString("yyyy-MM-dd")
    });

    var formasJs = Model.Vm.Combos.Formas.Select(f => new { id = f.IdFormaPagamento, nome = f.DsFormaPagamento });
    var condicoesJs = Model.Vm.Combos.Condicoes.Select(c => new { id = c.IdCondicaoPagamento, nome = c.DsCondicao });
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-cart-plus me-2"></i>Cadastro de Compras
            @if (Model.Vm.Edicao)
            {
                <span class="badge-status @statusBadge ms-2">@Model.Vm.Compra.TpStatus</span>
            }
        </h1>
        <p class="page-subtitle">Registro de entrada de produtos e serviços adquiridos</p>
    </div>
    <a class="btn btn-secondary" asp-page="/Compras/Compras">
        <i class="bi bi-arrow-left me-1"></i> Voltar
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.Erro</div>
}
@if (ro)
{
    <div class="alert alert-warning"><i class="bi bi-lock me-2"></i>@Model.Vm.MotivoBloqueio</div>
}

<form method="post" id="formCompra">
    <input type="hidden" asp-for="TpStatus" id="TpStatus" />
    <input type="hidden" asp-for="ItensJson" id="ItensJson" />
    <input type="hidden" asp-for="PagamentosJson" id="PagamentosJson" />
    <input type="hidden" asp-for="OrigNrNota" />
    <input type="hidden" asp-for="OrigNrSerie" />
    <input type="hidden" asp-for="OrigNrModelo" />
    <input type="hidden" asp-for="OrigIdFornecedor" />

    <!-- ================= Dados da Nota ================= -->
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-file-earmark-text me-2"></i>Dados da Nota</h6>
            <div class="row g-3">
                <div class="col-md-3 col-lg-4 col-xxl-3">
                    <label class="form-label">Modelo *</label>
                    <select class="form-select" asp-for="NrModelo" id="NrModelo" disabled="@chaveTravada">
                        <option value="55">NFe - Nota Fiscal Eletrônica</option>
                        <option value="65">NFCe - Nota Fiscal de Consumidor</option>
                        <option value="1">NF - Nota Fiscal Modelo 1</option>
                        <option value="2">NF - Nota Fiscal de Venda a Consumidor</option>
                    </select>
                </div>
                <div class="col-md-2 col-lg-1 col-xxl-2">
                    <label class="form-label">Série *</label>
                    <input type="number" min="0" class="form-control" asp-for="NrSerie" id="NrSerie" disabled="@chaveTravada" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Nº *</label>
                    <input type="number" min="1" class="form-control" asp-for="NrNota" id="NrNota" disabled="@chaveTravada" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">ID Fornecedor *</label>
                    <div class="input-group">
                        <input type="number" min="1" class="form-control" asp-for="IdFornecedor" id="IdFornecedor" disabled="@chaveTravada" />
                        @if (!chaveTravada)
                        {
                            <button type="button" class="btn btn-outline-primary" id="btnBuscaFornecedor" title="Pesquisar fornecedor" onclick="abrirBuscaFornecedor()">
                                <i class="bi bi-search"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fornecedor</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="nomeFornecedor"
                               value="@(Model.Vm.Compra.Fornecedor?.DsRazaoSocial)" placeholder="Informe o ID ao lado" readonly />
                        @if (!chaveTravada)
                        {
                            <button type="button" class="btn btn-primary" id="btnValidarChave" title="Validar a chave da nota" onclick="validarChave()">
                                <i class="bi bi-check2-circle me-1"></i>Validar
                            </button>
                        }
                    </div>
                </div>
                @if (!chaveTravada)
                {
                    <div class="col-md-12 mt-1">
                        <small class="text-muted" id="chaveMsg">
                            <i class="bi bi-info-circle me-1"></i>Informe modelo, série, número e fornecedor e clique em
                            <strong>Validar</strong> para liberar os demais campos.
                        </small>
                    </div>
                }

                @* Etapa 2: datas, liberadas so depois da chave validada. *@
                <fieldset class="col-md-6 etapa-datas" disabled="@(!chaveOk)">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Data de Emissão *</label>
                            <input type="date" class="form-control" asp-for="DtEmissao" id="DtEmissao"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@ro" />
                            <div class="invalid-feedback" id="DtEmissaoErro"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Data de Chegada</label>
                            <input type="date" class="form-control" asp-for="DtChegada" id="DtChegada"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@ro" />
                            <div class="invalid-feedback" id="DtChegadaErro"></div>
                        </div>
                    </div>
                </fieldset>

                @* Etapa 3: demais campos, liberados com chave e datas validas. *@
                <fieldset class="col-md-6 etapa-demais" disabled="@(!chaveOk)">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">ID Transportadora</label>
                            <div class="input-group">
                                <input type="number" min="1" class="form-control" asp-for="IdTransportador" id="IdTransportador" disabled="@ro" />
                                @if (!ro)
                                {
                                    <button type="button" class="btn btn-outline-primary" title="Pesquisar transportadora" onclick="abrirBuscaTransportador()">
                                        <i class="bi bi-search"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Transportadora</label>
                            <input type="text" class="form-control" id="nomeTransportador"
                                   value="@(Model.Vm.Compra.Transportador?.DsRazaoSocial)" placeholder="Opcional" readonly />
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <fieldset class="etapa-demais" disabled="@(!chaveOk)">
    @if (!ro)
    {
        <!-- ================= Adicionar Produto / Serviço ================= -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-box-seam me-2"></i>Adicionar Produto / Serviço</h6>
                <div class="row g-2 align-items-end">
                    <div class="col-md-2 col-xxl-1">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="itTipo" onchange="onTipoChange()">
                            <option value="PRODUTO">Produto</option>
                            <option value="SERVICO">Serviço</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-xxl-5">
                        <label class="form-label">Produto / Serviço</label>
                        <div class="input-group">
                            <input type="number" min="1" class="form-control" id="itCodigo" placeholder="ID" onchange="onCodigoItemChange()" />
                            <button type="button" class="btn btn-outline-primary" title="Pesquisar" onclick="abrirBuscaItem()">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                        <small class="text-muted" id="itDescricao"></small>
                    </div>
                    <div class="col-md-2 col-xxl-1">
                        <label class="form-label">UND</label>
                        <select class="form-select" id="itUnidade">
                            <option value="">-</option>
                            <option value="UN">UN</option>
                            <option value="PC">PC</option>
                            <option value="CX">CX</option>
                            <option value="KG">KG</option>
                            <option value="G">G</option>
                            <option value="L">L</option>
                            <option value="ML">ML</option>
                            <option value="M">M</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-xxl-1">
                        <label class="form-label">Quantidade</label>
                        <input type="number" step="0.0001" min="0" class="form-control" id="itQt" value="1" />
                    </div>
                    <div class="col-md-3 col-xxl-1">
                        <label class="form-label">Preço Unit.</label>
                        <input type="number" step="0.0001" min="0" class="form-control" id="itVlUnit" value="0" />
                    </div>
                    <div class="col-md-6 col-xxl-2">
                        @* Porcentagem e valor ficam abaixo do rotulo Desconto e
                           se recalculam entre si (ver calcItemTotal). *@
                        <label class="form-label mb-1">Desconto</label>
                        <div class="row g-1">
                            <div class="col-6">
                                <small class="text-muted d-block">Porcentagem</small>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0" max="100" class="form-control px-2" id="itDescPerc" value="0" />
                                    <span class="input-group-text px-2">%</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Valor</small>
                                <div class="input-group">
                                    <span class="input-group-text px-2">R$</span>
                                    <input type="number" step="0.01" min="0" class="form-control px-2" id="itDesc" value="0" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-xxl-1">
                        <label class="form-label">Total</label>
                        <input type="text" class="form-control" id="itTotal" readonly />
                    </div>
                    <div class="col-md-12 mt-3">
                        <button type="button" class="btn btn-primary" onclick="adicionarItem()">
                            <i class="bi bi-plus-lg me-1"></i>Adicionar Produto
                        </button>
                        <button type="button" class="btn btn-outline-secondary ms-1" onclick="limparItemForm()">
                            <i class="bi bi-eraser me-1"></i>Limpar
                        </button>
                        <span class="text-muted small ms-2" id="itEditando"></span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ================= Lista de Produtos / Serviços ================= -->
    <div class="table-container mb-3">
        <div class="table-header">
            <h5><i class="bi bi-list-ul me-2"></i>Lista de Produtos / Serviços</h5>
            <span class="text-muted small" id="contadorItens">0 itens</span>
        </div>
        <div class="table-responsive">
            <table class="table" id="tblItens">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Produto / Serviço</th>
                        <th class="text-center">UND</th>
                        <th class="text-end">Qtd.</th>
                        <th class="text-end">Preço Unit.</th>
                        <th class="text-end">Desconto</th>
                        <th class="text-end">Total</th>
                        <th class="text-end" title="Parcela do frete + seguro + outros gastos">Rateio</th>
                        <th class="text-end" title="(Total + Rateio) / Quantidade">Custo Unit.</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody id="itensBody"></tbody>
                <tfoot id="itensFoot">
                    <tr>
                        <th colspan="3" class="text-end">Totais</th>
                        <th class="text-end" id="totQtd"></th>
                        <th></th>
                        <th class="text-end" id="totDesconto"></th>
                        <th class="text-end" id="totItens"></th>
                        <th class="text-end" id="totRateio"></th>
                        <th colspan="2"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ================= Custos e Totais ================= -->
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-bar-chart-line me-2"></i>Custos e Totais</h6>
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Frete (R$)</label>
                    <input type="number" step="0.01" min="0" class="form-control" asp-for="VlFrete" id="VlFrete" disabled="@ro" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Seguro (R$)</label>
                    <input type="number" step="0.01" min="0" class="form-control" asp-for="VlSeguro" id="VlSeguro" disabled="@ro" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Outros Gastos (R$)</label>
                    <input type="number" step="0.01" min="0" class="form-control" asp-for="VlOutrasDespesas" id="VlOutrasDespesas" disabled="@ro" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Total dos Produtos</label>
                    <input type="text" class="form-control" id="lblTotalProdutos" value="R$ 0,00" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Custo Adicional</label>
                    <input type="text" class="form-control" id="lblCustoAdicional" value="R$ 0,00" readonly />
                </div>
                <div class="col-md-2">
                    @* kpi-value (1.75rem) nao cabe em col-md-2 sem quebrar o
                       valor em varias linhas; fs-5 mantem o mesmo card e a
                       mesma cor de destaque com o valor em uma linha so. *@
                    <div class="card kpi-card kpi-blue mb-0">
                        <div class="card-body py-2">
                            <div class="kpi-label">Total da Compra</div>
                            <div class="fs-5 fw-bold text-primary mt-1" id="lblTotalCompra">R$ 0,00</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Pagamento ================= -->
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-credit-card me-2"></i>Pagamento</h6>
            @if (!ro)
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Condição de Pagamento</label>
                        <div class="input-group">
                            <select class="form-select" asp-for="IdCondicaoPagamento" id="IdCondicaoPagamento">
                                <option value="">Selecione</option>
                                @foreach (var c in Model.Vm.Combos.Condicoes)
                                {
                                    <option value="@c.IdCondicaoPagamento">@c.DsCondicao</option>
                                }
                            </select>
                            <!-- Abre o componente compartilhado de condicao de pagamento -->
                            <button type="button" class="btn btn-outline-primary" id="btnNovaCondicao"
                                    title="Cadastrar nova condição de pagamento" onclick="novaCondicaoCompra()">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Forma de Pagamento</label>
                        <select class="form-select" id="pgForma">
                            <option value="">Selecione</option>
                            @foreach (var f in Model.Vm.Combos.Formas)
                            {
                                <option value="@f.IdFormaPagamento">@f.DsFormaPagamento</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Valor (R$)</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="pgValor" value="0" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Vencimento</label>
                        <input type="date" class="form-control" id="pgVencimento" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary w-100" onclick="adicionarPagamento()">
                            <i class="bi bi-plus-lg me-1"></i>Adicionar
                        </button>
                    </div>
                    <div class="col-md-12">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="gerarParcelasDaCondicao()">
                            <i class="bi bi-magic me-1"></i>Gerar parcelas pela condição de pagamento
                        </button>
                        <span class="text-muted small ms-2 d-none" id="condicaoFornecedorAviso">
                            <i class="bi bi-lock me-1"></i>Condição definida no cadastro do fornecedor.
                        </span>
                        <span class="text-muted small ms-2" id="pgEditando"></span>
                    </div>
                </div>
            }

            <div class="table-responsive mt-3">
                <table class="table" id="tblPagamentos">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Condição de Pagamento</th>
                            <th>Forma de Pagamento</th>
                            <th class="text-end">Valor</th>
                            <th>Vencimento</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="pagamentosBody"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total das Parcelas</th>
                            <th class="text-end" id="lblTotalParcelas">R$ 0,00</th>
                            <th colspan="2" id="lblDiferencaParcelas"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= Observação ================= -->
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-chat-left-text me-2"></i>Observação</h6>
            <textarea class="form-control" asp-for="DsObservacao" rows="3" maxlength="500" disabled="@ro"></textarea>
        </div>
    </div>
    </fieldset>

    @if (Model.Vm.ContasGeradas.Any())
    {
        <!-- ================= Títulos gerados no Contas a Pagar ================= -->
        <div class="table-container mb-3">
            <div class="table-header">
                <h5><i class="bi bi-cash-stack me-2"></i>Contas a Pagar geradas por esta compra</h5>
                <span class="text-muted small">@Model.Vm.ContasGeradas.Count títulos</span>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Conta</th>
                            <th>Vencimento</th>
                            <th class="text-end">Valor</th>
                            <th class="text-end">Pago</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var conta in Model.Vm.ContasGeradas)
                        {
                            var badgeConta = conta.DsStatus switch
                            {
                                ContaAPagar.PAGO => "badge-concluido",
                                ContaAPagar.CANCELADO => "badge-cancelado",
                                _ => "badge-agendado"
                            };
                            <tr>
                                <td><strong>#@conta.IdContaPagar</strong></td>
                                <td>@conta.DsConta</td>
                                <td>@(conta.DtVencimento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end">R$ @conta.VlValor.ToString("N2")</td>
                                <td class="text-end">R$ @conta.VlPago.ToString("N2")</td>
                                <td><span class="badge-status @badgeConta">@conta.DsStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ================= Ações ================= -->
    <div class="card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <a class="btn btn-secondary" asp-page="/Compras/Compras">
                <i class="bi bi-x-lg me-1"></i>Cancelar
            </a>
            @if (!ro)
            {
                @* Situacao do salvamento automatico (so em rascunho) *@
                <span class="small text-muted ms-auto me-3" id="autoSalvarStatus"></span>
                <fieldset class="etapa-demais d-flex gap-2" disabled="@(!chaveOk)">
                    <button type="button" class="btn btn-outline-primary" onclick="salvar('RASCUNHO')">
                        <i class="bi bi-file-earmark-text me-1"></i>Salvar Rascunho
                    </button>
                    <button type="button" class="btn btn-primary" onclick="salvar('FINALIZADA')">
                        <i class="bi bi-check2-circle me-1"></i>Salvar Compra
                    </button>
                </fieldset>
            }
        </div>
    </div>
</form>

<!-- ================= Modal: pesquisa de fornecedor ================= -->
<div class="modal fade" id="modalBusca" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="buscaTitulo">Pesquisar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="search-box flex-grow-1">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="form-control" id="buscaTermo" placeholder="Digite para pesquisar..." autocomplete="off" />
                    </div>
                    <!-- So aparece na pesquisa de fornecedor e de produto: abre o
                         componente de cadastro correspondente. -->
                    <button type="button" class="btn btn-primary d-none" id="btnBuscaNovo"
                            title="Cadastrar novo" onclick="novoCadastroBusca()">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <!-- Altura limitada: a lista rola por dentro e o cabecalho fica fixo. -->
                <div class="table-responsive busca-resultados">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 90px;">Código</th>
                                <th>Descrição</th>
                                <th class="text-center" style="width: 90px;">Selecionar</th>
                            </tr>
                        </thead>
                        <tbody id="buscaBody">
                            <tr><td colspan="3" class="text-center text-muted py-3">Digite para pesquisar</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!chaveTravada)
{
    <!-- Cadastro de fornecedor (componente compartilhado com a tela de Fornecedores).
         Fica fora do formCompra: tem o proprio <form> e grava por AJAX. -->
    @await Component.InvokeAsync("CadastroFornecedor", new { modo = "ajax" })
}
else if (!ro)
{
    <!-- Cadastro de condicao de pagamento (+ do bloco Pagamento). Antes da chave
         validada ele ja vem dentro do componente de fornecedor. -->
    @await Component.InvokeAsync("CadastroCondicaoPagamento", new { modo = "ajax" })
}

@if (!ro)
{
    <!-- Cadastro de produto (componente compartilhado com a tela de Produtos),
         aberto pelo + da pesquisa de produto. Tambem grava por AJAX. -->
    @await Component.InvokeAsync("CadastroProduto", new { modo = "ajax" })
}

@section Scripts {
    @if (!chaveTravada)
    {
        <script src="~/js/Gerais/CadastroFornecedor.js" asp-append-version="true"></script>
    }
    @if (!ro)
    {
        <script src="~/js/Estoque/CadastroProduto.js" asp-append-version="true"></script>
    }
    <script type="application/json" id="dadosTela">
    {
        "FORMAS": @Json.Serialize(formasJs),
        "CONDICOES": @Json.Serialize(condicoesJs),
        "SOMENTE_LEITURA": @Json.Serialize(Model.Vm.SomenteLeitura),
        "CONDICAO_FORNECEDOR": @Json.Serialize(Model.CondicaoFornecedor),
        "chaveValidada": @Json.Serialize(chaveOk),
        "ITENS": @Json.Serialize(itensJs),
        "PAGAMENTOS": @Json.Serialize(pagamentosJs),
        "AUTO_SALVAR": @Json.Serialize(salvarSozinho)
    }
    </script>
    <script src="~/Pages/Compras/Compra.cshtml.js" asp-append-version="true"></script>
}
