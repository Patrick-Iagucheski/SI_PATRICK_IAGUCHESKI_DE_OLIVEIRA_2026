@page
@model WebAppERP.Pages.Compras.ComprasModel
@{
    ViewData["Title"] = "Compras";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Compras</h1>
        <p class="page-subtitle">Registro de entrada de produtos e serviços adquiridos</p>
    </div>
    <a class="btn btn-primary" asp-page="/Compras/Compra">
        <i class="bi bi-plus-lg me-1"></i> Nova Compra
    </a>
</div>

<!-- Filtros de busca (todos opcionais e combinaveis) -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">Nº da Nota</label>
                <input type="number" class="form-control" id="buscaId" min="1" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Fornecedor</label>
                <input type="text" class="form-control" id="buscaTexto" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Situação</label>
                <select class="form-select" id="buscaSituacao">
                    <option value="">Todas</option>
                    <option value="@Compra.RASCUNHO">Rascunho</option>
                    <option value="@Compra.FINALIZADA">Finalizada</option>
                    <option value="@Compra.CANCELADA">Cancelada</option>
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="aplicarBusca()">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabela -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="bi bi-cart-plus me-2"></i>Lista de Compras</h5>
        <span class="text-muted small" id="contadorRegistros">@Model.Compras.Count registros encontrados</span>
    </div>
    <div class="table-responsive">
        <table class="table" id="tblCompras">
            <thead>
                <tr>
                    <th>Nota</th>
                    <th>Fornecedor</th>
                    <th>Emissão</th>
                    <th>Chegada</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Compras.Any())
                {
                    @foreach (var c in Model.Compras)
                    {
                        var badge = c.TpStatus switch
                        {
                            Compra.FINALIZADA => "badge-concluido",
                            Compra.CANCELADA => "badge-cancelado",
                            _ => "badge-agendado"
                        };
                        <tr data-id="@c.NrNota" data-status="@c.TpStatus">
                            <td>
                                <strong>Nº @c.NrNota</strong>
                                <div class="text-muted small">Modelo @c.NrModelo · Série @c.NrSerie</div>
                            </td>
                            <td>@(c.Fornecedor?.DsRazaoSocial ?? "-")</td>
                            <td>@c.DtEmissao.ToString("dd/MM/yyyy")</td>
                            <td>@(c.DtChegada?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-end"><strong>R$ @c.VlTotalCompra.ToString("N2")</strong></td>
                            <td><span class="badge-status @badge">@c.TpStatus</span></td>
                            <td class="text-center" style="white-space: nowrap;">
                                <a class="btn btn-icon btn-outline-primary" title="@(c.TpStatus == Compra.RASCUNHO ? "Editar" : "Visualizar")"
                                   asp-page="/Compras/Compra"
                                   asp-route-nrNota="@c.NrNota" asp-route-nrSerie="@c.NrSerie"
                                   asp-route-nrModelo="@c.NrModelo" asp-route-idFornecedor="@c.IdFornecedor">
                                    <i class="bi @(c.TpStatus == Compra.RASCUNHO ? "bi-pencil" : "bi-eye")"></i>
                                </a>
                                @* Cancelar so em compra finalizada (estorna estoque e titulos e libera
                                   o numero). Rascunho nao movimentou nada: sai pelo Excluir. *@
                                @if (c.TpStatus == Compra.FINALIZADA)
                                {
                                    <form method="post" asp-page-handler="Cancelar" class="d-inline"
                                          onsubmit="return confirm('Deseja cancelar esta compra? O estoque será estornado e os títulos do Contas a Pagar serão cancelados.')">
                                        <input type="hidden" name="nrNota" value="@c.NrNota" />
                                        <input type="hidden" name="nrSerie" value="@c.NrSerie" />
                                        <input type="hidden" name="nrModelo" value="@c.NrModelo" />
                                        <input type="hidden" name="idFornecedor" value="@c.IdFornecedor" />
                                        <button type="submit" class="btn btn-icon btn-outline-warning" title="Cancelar compra">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                                @* So rascunho sai pelo Excluir: finalizada e cancelada ficam no historico *@
                                @if (c.TpStatus == Compra.RASCUNHO)
                                {
                                    <form method="post" asp-page-handler="Excluir" class="d-inline"
                                          onsubmit="return confirm('Deseja realmente excluir esta compra?')">
                                        <input type="hidden" name="nrNota" value="@c.NrNota" />
                                        <input type="hidden" name="nrSerie" value="@c.NrSerie" />
                                        <input type="hidden" name="nrModelo" value="@c.NrModelo" />
                                        <input type="hidden" name="idFornecedor" value="@c.IdFornecedor" />
                                        <button type="submit" class="btn btn-icon btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma compra registrada</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/Pages/Compras/Compras.cshtml.js" asp-append-version="true"></script>
}
